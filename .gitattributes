# Normalizacja końców linii — skrypty serwerowe muszą mieć LF.
* text=auto
*.sh text eol=lf
*.php text eol=lf
*.astro text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.tar.gz binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.7z binary
