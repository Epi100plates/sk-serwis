---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { withBase } from '../lib/url';

const services = (await getCollection('uslugi', ({ data }) => (typeof process !== "undefined" && process.env.PREVIEW === "1") || !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

// Ilustracje techniczne przypisane do usług (podmieniane na zdjęcia z panelu Media).
const artBySlug: Record<string, string> = {
  'naprawa-laptopow-wroclaw': 'case-power',
  'serwis-laptopow-wroclaw': 'case-power',
  'czyszczenie-laptopa-wroclaw': 'case-cooling',
  'przyspieszanie-laptopa-wroclaw': 'case-board',
  'wymiana-matrycy-wroclaw': 'case-screen',
  'naprawa-laptopa-po-zalaniu': 'case-liquid',
  'naprawa-plyt-glownych': 'case-board',
  'naprawa-gniazda-zasilania': 'case-socket',
  'naprawa-zawiasow': 'case-hinge',
  'naprawa-portow-usb-hdmi': 'case-socket',
  'odzyskiwanie-danych-wroclaw': 'case-board',
  'instalacja-windows-wroclaw': 'case-board',
  'diagnostyka-laptopa-wroclaw': 'case-board',
  'naprawa-komputerow-wroclaw': 'case-board',
  'wymiana-klawiatury-laptopa': 'case-hinge',
  'naprawa-laptopa-ktory-sie-nie-wlacza': 'case-power',
};

const items = services.map((s) => ({
  ...s,
  art: s.data.image || `/images/realizacje/${artBySlug[s.id] ?? 'case-board'}.svg`,
  isUpload: Boolean(s.data.image),
}));
---

<section class="section services-showcase" aria-labelledby="services-title">
  <div class="container services-showcase__grid">
    <div class="services-showcase__head">
      <div class="section-head">
        <h2 id="services-title">Co najczęściej naprawiamy</h2>
      </div>
      <p class="services-showcase__lead">
        Od czyszczenia chłodzenia po naprawy płyt głównych. Każda pozycja prowadzi
        do strony z zakresem pracy, typowymi objawami i cenami.
      </p>
      <a class="link-arrow services-showcase__all" href={withBase('/uslugi/')}>
        Wszystkie usługi <Icon name="arrow" size={16} />
      </a>
      <div class="services-showcase__note">
        <p class="mono">Diagnoza</p>
        <p><strong>0 zł przy naprawie*</strong> — jeśli zrezygnujesz z naprawy, diagnostyka jest płatna. Kwotę podajemy przed pracą.</p>
      </div>
    </div>

    <ul class="services-showcase__list">
      {
        items.map((s) => (
          <li>
            <a
              class="showcase-row"
              href={withBase(`/${s.id}/`)}
              data-track="service"
              data-location="home-uslugi"
            >
              <span class="showcase-row__media">
                <img
                  src={s.isUpload ? withBase(s.art) : withBase(s.art)}
                  alt={s.data.imageAlt ?? ''}
                  width="240"
                  height="180"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="showcase-row__body">
                <span class="showcase-row__title">{s.data.navLabel}</span>
                <span class="showcase-row__teaser">{s.data.teaser}</span>
              </span>
              <span class="showcase-row__meta">
                {s.data.priceFrom && <span class="mono">{s.data.priceFrom}</span>}
                <Icon name="arrow" size={17} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services-showcase__grid {
    display: grid;
    grid-template-columns: minmax(240px, 0.55fr) minmax(0, 1.45fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .services-showcase__head {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .services-showcase .section-head {
    display: block;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    margin-bottom: 0;
  }

  .services-showcase .section-head h2 {
    max-width: 12ch;
  }

  .services-showcase__lead {
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 34ch;
  }

  .services-showcase__all {
    font-size: 14px;
  }

  .services-showcase__note {
    margin-top: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--muted);
    max-width: 34ch;
  }

  .services-showcase__note .mono {
    color: var(--muted-2);
    font-size: 10px;
    margin-bottom: 4px;
  }

  .services-showcase__note strong {
    color: var(--ink);
  }

  .services-showcase__list {
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .showcase-row {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) auto;
    align-items: center;
    gap: 20px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    transition: background var(--fast) var(--ease-out);
  }

  .showcase-row:hover {
    background: var(--surface);
  }

  .showcase-row__media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--graphite);
    border: 1px solid var(--line);
  }

  .showcase-row__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }

  .showcase-row:hover .showcase-row__media img {
    transform: scale(1.06);
  }

  .showcase-row__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .showcase-row__title {
    font-size: clamp(17px, 1.5vw, 21px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .showcase-row:hover .showcase-row__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    text-decoration-color: var(--yellow);
  }

  .showcase-row__teaser {
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--muted);
    max-width: 58ch;
  }

  .showcase-row__meta {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: none;
    color: var(--muted);
    font-size: 11px;
    white-space: nowrap;
  }

  .showcase-row:hover .showcase-row__meta svg {
    transform: translateX(3px);
  }

  .showcase-row__meta svg {
    transition: transform var(--fast) var(--ease-out);
  }

  @media (max-width: 960px) {
    .services-showcase__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .services-showcase__head {
      position: static;
    }

    .services-showcase__lead,
    .services-showcase__note {
      max-width: none;
    }

    .services-showcase__note {
      display: none;
    }

    .showcase-row {
      grid-template-columns: 56px minmax(0, 1fr) auto;
      gap: 12px;
      padding: 10px 0;
    }

    .showcase-row__teaser {
      display: none;
    }

    .showcase-row__meta .mono {
      display: none;
    }

    .showcase-row__title {
      font-size: 15.5px;
    }

    /* Na telefonie lista jest krótka — szczegóły są na podstronach. */
    .services-showcase__list li:nth-child(n + 5) {
      display: none;
    }

    .showcase-row {
      padding: 8px 0;
    }

    .services-showcase .section-head {
      padding-top: 16px;
    }

    .services-showcase__all {
      font-size: 13.5px;
    }
  }
</style>
