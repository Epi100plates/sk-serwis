---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { withBase } from '../lib/url';

const isPreview = typeof process !== 'undefined' && process.env.PREVIEW === '1';

const services = (await getCollection('uslugi', ({ data }) => isPreview || !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

// Ilustracje techniczne przypisane do usług (podmieniane na zdjęcia z panelu Media).
const artBySlug: Record<string, string> = {
  'naprawa-laptopow-wroclaw': 'case-power',
  'serwis-laptopow-wroclaw': 'case-power',
  'czyszczenie-laptopa-wroclaw': 'case-cooling',
  'przyspieszanie-laptopa-wroclaw': 'case-board',
  'wymiana-matrycy-wroclaw': 'case-screen',
  'naprawa-laptopa-po-zalaniu': 'case-liquid',
  'naprawa-plyt-glownych': 'case-board',
  'naprawa-gniazda-zasilania': 'case-socket',
  'naprawa-zawiasow': 'case-hinge',
  'naprawa-portow-usb-hdmi': 'case-socket',
  'odzyskiwanie-danych-wroclaw': 'case-board',
  'instalacja-windows-wroclaw': 'case-board',
  'diagnostyka-laptopa-wroclaw': 'case-board',
  'naprawa-komputerow-wroclaw': 'case-board',
  'wymiana-klawiatury-laptopa': 'case-hinge',
  'naprawa-laptopa-ktory-sie-nie-wlacza': 'case-power',
};

// Kafelkami steruje panel CMS (pole `tile`). Gdy żadna usługa nie ma kafelka
// (np. świeża treść), pokazujemy pierwsze 9 usług, żeby sekcja nie zniknęła.
const tileServices = services.filter((service) => service.data.tile === true);
const source = tileServices.length > 0 ? tileServices : services.slice(0, 9);

const tiles = source.map((service) => ({
  id: service.id,
  title: service.data.tileTitle?.trim() || service.data.navLabel,
  text: service.data.tileText?.trim() || service.data.teaser,
  href: withBase(`/${service.id}/`),
  art: withBase(
    service.data.image || `/images/realizacje/${artBySlug[service.id] ?? 'case-board'}.svg`
  ),
  alt: service.data.imageAlt ?? '',
}));

// Telefon w układzie mobilnym pokazuje 6 kafelków - limit wysokości strony głównej.
const mobileVisible = Math.min(tiles.length, 6);
const hiddenOnMobile = tiles.length - mobileVisible;
---

<section class="section services-showcase" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head services-showcase__head">
      <h2 id="services-title">Co najczęściej naprawiamy</h2>
      <div class="section-head__aside">
        <p class="services-showcase__lead">
          Od czyszczenia chłodzenia po naprawy płyt głównych. Wybierz usługę, żeby
          zobaczyć zakres pracy, typowe objawy i ceny.
        </p>
        <a
          class="link-arrow services-showcase__all"
          href={withBase('/uslugi/')}
          data-track="service"
          data-location="home-uslugi"
        >
          Wszystkie usługi <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>

    <ul class="service-tiles" data-service-tiles>
      {
        tiles.map((tile) => (
          <li class="service-tile" data-service-tile data-service-title={tile.title}>
            <button
              class="service-tile__toggle"
              type="button"
              aria-expanded="false"
              aria-controls={`service-tile-panel-${tile.id}`}
            >
              <span class="visually-hidden service-tile__toggle-label">
                Pokaż opis: {tile.title}
              </span>
            </button>

            <div class="service-tile__media">
              <img
                src={tile.art}
                alt={tile.alt}
                width="640"
                height="480"
                loading="lazy"
                decoding="async"
              />
            </div>

            <h3 class="service-tile__title">{tile.title}</h3>

            <div class="service-tile__panel" id={`service-tile-panel-${tile.id}`}>
              <p class="service-tile__text">{tile.text}</p>
              <a
                class="service-tile__cta"
                href={tile.href}
                data-track="service"
                data-location="home-uslugi"
              >
                Zobacz usługę <Icon name="arrow" size={15} />
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="services-showcase__foot">
      <div class="services-showcase__note">
        <p class="mono">Diagnoza</p>
        <p>
          <strong>0 zł przy naprawie*</strong> - jeśli zrezygnujesz z naprawy,
          diagnostyka jest płatna. Kwotę podajemy przed pracą.
        </p>
      </div>

      {
        hiddenOnMobile > 0 && (
          <div class="mobile-only">
            <div class="services-showcase__more">
              <p class="mono">
                Pokazujemy {mobileVisible} z {tiles.length} usług
              </p>
              <a
                class="btn btn--outline btn--block"
                href={withBase('/uslugi/')}
                data-track="service"
                data-location="home-uslugi"
              >
                Wszystkie usługi <Icon name="arrow" size={16} class="icon-arrow" />
              </a>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  (function () {
    const lists = document.querySelectorAll('[data-service-tiles]');

    Array.prototype.forEach.call(lists, function (list) {
      if (list.getAttribute('data-ready') === 'true') return;
      list.setAttribute('data-ready', 'true');

      const tiles = Array.prototype.slice.call(
        list.querySelectorAll('[data-service-tile]')
      );

      function setState(tile, open) {
        const button = tile.querySelector('.service-tile__toggle');
        const title = tile.getAttribute('data-service-title') || '';

        tile.classList.toggle('is-open', open);
        if (!button) return;

        button.setAttribute('aria-expanded', open ? 'true' : 'false');

        const label = button.querySelector('.service-tile__toggle-label');
        if (label) {
          label.textContent = (open ? 'Ukryj opis: ' : 'Pokaż opis: ') + title;
        }
      }

      function closeOthers(current) {
        tiles.forEach(function (tile) {
          if (tile !== current) setState(tile, false);
        });
      }

      tiles.forEach(function (tile) {
        const button = tile.querySelector('.service-tile__toggle');
        if (!button) return;

        button.addEventListener('click', function (event) {
          const open = !tile.classList.contains('is-open');
          closeOthers(tile);
          setState(tile, open);

          // Po kliknięciu myszą lub dotknięciem zwinięty kafelek nie może
          // zostać otwarty przez sam fokus (:focus-within) - zdejmujemy go.
          if (!open && event.detail > 0) button.blur();
        });
      });

      list.addEventListener('keydown', function (event) {
        if (event.key !== 'Escape' && event.key !== 'Esc') return;

        const openTile = list.querySelector('.service-tile.is-open');
        if (!openTile) return;

        setState(openTile, false);
        const button = openTile.querySelector('.service-tile__toggle');
        if (button) button.focus();
      });
    });
  })();
</script>

<style>
  .services-showcase .section-head {
    margin-bottom: clamp(24px, 3.4vw, 48px);
  }

  .services-showcase__lead {
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 44ch;
  }

  .services-showcase__all {
    font-size: 14px;
  }

  /* ------------------------------------------------------------- siatka */
  .service-tiles {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    /* Bez overflow: hidden - powiększony kafelek nie może być przycięty. */
    gap: clamp(16px, 1.9vw, 26px);
  }

  .service-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    transition: transform 200ms var(--ease-out);
  }

  .service-tile:hover,
  .service-tile:focus-within {
    z-index: 2;
  }

  .service-tile__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--graphite);
    border: 1px solid var(--line);
    transition: border-color var(--fast) var(--ease-out);
  }

  .service-tile__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 220ms var(--ease-out),
      filter 220ms var(--ease-out);
  }

  .service-tile__title {
    margin-top: 12px;
    font-size: clamp(16px, 1.5vw, 20px);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  /* Rozwijanie opisu: cała powierzchnia kafelka, osobny przycisk dla klawiatury. */
  .service-tile__toggle {
    position: absolute;
    inset: 0;
    z-index: 1;
    padding: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .service-tile__toggle:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .service-tile__panel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    aspect-ratio: 4 / 3;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 10px;
    padding: clamp(12px, 1.4vw, 18px);
    background: linear-gradient(
      to top,
      rgba(36, 42, 48, 0.97) 0%,
      rgba(36, 42, 48, 0.88) 55%,
      rgba(36, 42, 48, 0) 100%
    );
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    pointer-events: none;
    transition:
      opacity var(--fast) var(--ease-out),
      transform var(--fast) var(--ease-out),
      visibility 0s linear var(--fast);
  }

  .service-tile__text {
    font-size: 13px;
    line-height: 1.45;
    color: var(--on-dark);
  }

  .service-tile__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    padding-bottom: 2px;
    font-size: 13px;
    font-weight: 600;
    color: var(--on-dark);
    border-bottom: 1px solid var(--yellow);
    pointer-events: auto;
    transition: border-color var(--fast) var(--ease-out);
  }

  .service-tile__cta:hover {
    border-bottom-color: var(--on-dark);
  }

  .service-tile__cta:focus-visible {
    outline-color: var(--yellow);
  }

  /* Stan aktywny: klawiatura (:focus-within) i dotyk (.is-open). */
  .service-tile:focus-within .service-tile__panel,
  .service-tile.is-open .service-tile__panel {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .service-tile:focus-within .service-tile__media,
  .service-tile.is-open .service-tile__media {
    border-color: var(--line-strong);
  }

  .service-tile:focus-within .service-tile__media img,
  .service-tile.is-open .service-tile__media img {
    filter: brightness(0.78);
  }

  .service-tile:hover .service-tile__media {
    border-color: var(--line-strong);
  }

  /* Stan aktywny: mysz (hover). */
  @media (hover: hover) and (pointer: fine) {
    .service-tile:hover {
      transform: translateY(-3px) scale(1.015);
    }

    .service-tile:hover .service-tile__panel {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }

    .service-tile:hover .service-tile__media img {
      filter: brightness(0.78);
      transform: scale(1.03);
    }
  }

  /* --------------------------------------------------- stopka pod siatką */
  .services-showcase__foot {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: clamp(22px, 2.8vw, 34px);
  }

  .services-showcase__note {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--muted);
    max-width: 82ch;
  }

  .services-showcase__note .mono {
    font-size: 10px;
    color: var(--muted-2);
  }

  .services-showcase__note strong {
    color: var(--ink);
  }

  .services-showcase__more {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .services-showcase__more .mono {
    font-size: 10.5px;
    color: var(--muted-2);
  }

  /* ------------------------------------------------------------- układ */
  @media (max-width: 1023px) {
    .service-tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Układ mobilny strony (≤899 px, tak jak reszta sekcji) - 6 kafelków i link. */
  @media (max-width: 899px) {
    .service-tiles > li:nth-child(n + 7) {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .service-tiles {
      gap: 12px;
    }

    .service-tile__title {
      margin-top: 8px;
      font-size: 14.5px;
      line-height: 1.25;
    }

    /* Na telefonie opis rozwija się pod tytułem, nie zasłania zdjęcia. */
    .service-tile__panel {
      position: relative;
      inset: auto;
      z-index: 2;
      display: none;
      aspect-ratio: auto;
      justify-content: flex-start;
      gap: 8px;
      margin-top: 8px;
      padding: 12px;
      background: var(--surface);
      border: 1px solid var(--line);
      transform: none;
      opacity: 1;
      visibility: visible;
    }

    .service-tile.is-open .service-tile__panel {
      display: block;
    }

    .service-tile__text {
      font-size: 13px;
      line-height: 1.45;
      color: var(--ink);
    }

    .service-tile__cta {
      margin-top: 8px;
      font-size: 12.5px;
      color: var(--ink);
      border-bottom-color: var(--ink);
    }

    .service-tile.is-open .service-tile__media img {
      filter: none;
    }
  }

  @media (max-width: 379px) {
    .service-tiles {
      grid-template-columns: 1fr;
    }
  }
</style>
