  moon: 'M20 14.6A8.4 8.4 0 0 1 9.4 4a8.4 8.4 0 1 0 10.6 10.6Z',
};

const fillIcons: IconName[] = ['play', 'star', 'quote', 'bolt', 'google'];
const isFilled = filled ?? fillIcons.includes(name);
---

<svg
  class:list={['icon', `icon--${name}`, klass]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  part="icon"
>
  <path d={paths[name]} />
</svg>

<style>
  .icon {
    flex: none;
    display: inline-block;
    vertical-align: middle;
  }
</style>
