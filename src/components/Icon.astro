---
type IconName =
  | 'phone'
  | 'arrow'
  | 'arrow-up-right'
  | 'pin'
  | 'clock'
  | 'check'
  | 'chevron-down'
  | 'play'
  | 'shield'
  | 'thermometer'
  | 'fan'
  | 'screen'
  | 'keyboard'
  | 'battery'
  | 'drop'
  | 'chip'
  | 'tool'
  | 'speed'
  | 'star'
  | 'google'
  | 'menu'
  | 'close'
  | 'mail'
  | 'external'
  | 'bolt'
  | 'info'
  | 'quote'
  | 'sun'
  | 'moon';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  strokeWidth?: number;
  filled?: boolean;
