---
import Icon from './Icon.astro';
import site from '../data/site.json';
---

<div class="mobile-bar" aria-label="Szybki kontakt">
  <a
    class="mobile-bar__btn mobile-bar__btn--call"
    href={`tel:${site.phoneTel}`}
    data-track="call"
    data-location="mobile-bar"
  >
    <Icon name="phone" size={19} />
    <span>Zadzwoń</span>
  </a>
  <a
    class="mobile-bar__btn mobile-bar__btn--dir"
    href={site.directionsUrl}
    target="_blank"
    rel="noopener"
    data-track="directions"
    data-location="mobile-bar"
  >
    <Icon name="pin" size={19} />
    <span>Dojazd</span>
  </a>
</div>

<style>
  .mobile-bar {
    display: none;
  }

  @media (max-width: 899px) {
    .mobile-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 95;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1px;
      background: var(--graphite);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }

    .mobile-bar__btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      height: 58px;
      font-size: 15px;
      font-weight: 600;
      letter-spacing: 0.005em;
      background: var(--graphite);
      color: var(--on-dark);
      -webkit-tap-highlight-color: transparent;
    }

    .mobile-bar__btn--call {
      background: var(--yellow);
      color: var(--ink);
    }

    .mobile-bar__btn--dir {
      background: var(--graphite);
    }

    .mobile-bar__btn:active {
      filter: brightness(0.92);
    }
  }
</style>
