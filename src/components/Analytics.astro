---
import { getCollection } from 'astro:content';
import site from '../data/site.json';

const analytics = site.analytics;
const uslugi = await getCollection('uslugi', ({ data }) => (typeof process !== "undefined" && process.env.PREVIEW === "1") || !data.draft);

/**
 * Konfiguracja dla skryptu analityki — trafia do HTML jako JSON (data-config),
 * dzięki czemu sam skrypt inline zostaje mały (budżet 4 KB).
 * Puste pole = "nie ładuj": żadnych fałszywych ID (GTM/GA4/Clarity).
 */
const skConfig = {
  gtm: analytics.gtm || '',
  ga4: analytics.ga4 || '',
  ads: analytics.adsConversionSendTo || '',
  clarity: analytics.clarity || '',
  endpoint: analytics.endpoint || '',
  base: import.meta.env.BASE_URL.replace(/\/+$/, ''),
  reviews: site.reviews.url,
  services: uslugi.map((entry) => `/${entry.id}/`),
};
---

<div hidden data-sk-config data-config={JSON.stringify(skConfig)}></div>

<!--
  Skrypt jest celowo zminifikowany (inline < 4 KB, zero zależności, bez defer).
  Zawiera: Consent Mode v2 (default denied przed tagami + update po zgodzie),
  warunkowe ładowanie GTM / GA4 / Microsoft Clarity (Clarity tylko po zgodzie
  analitycznej, z maskowaniem formularzy), kolejkę zdarzeń (max 50) wysyłaną do
  site.analytics.endpoint (POST JSON: sendBeacon -> fetch keepalive, same-origin),
  publiczne window.skTrack(name, params), deduplikację name+page w 1200 ms oraz
  automatyczne wykrywanie: phone_click, directions_click, map_click, review_click,
  CTA_click, service_click, price_click, article_click, realization_click,
  contact_form_start, contact_form_submit. Nasłuchuje też sk:event (gallery_open,
  video_play, before_after_interaction, ...) i sk:form-success (generate_lead
  + opcjonalna konwersja Google Ads).
-->
