---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import { breadcrumbSchema } from '../../lib/schema';
import { applyPriceTokens } from '../../lib/prices';

interface Props {
  entry: any;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const title = applyPriceTokens(data.title);
const description = applyPriceTokens(data.description);
const h1 = applyPriceTokens(data.h1);
const lead = data.lead ? applyPriceTokens(data.lead) : description;

const schema = [
  breadcrumbSchema([
    { label: 'Start', path: '/' },
    { label: h1, path: `/${entry.id}/` },
  ]),
];
---

<Base
  title={`${title} | Studio-Komp`}
  description={description}
  canonicalPath={`/${entry.id}/`}
  schema={schema}
  noindex={data.noindex}
>
  <PageHero
    h1={h1}
    lead={lead}
    crumbs={[{ label: h1 }]}
    showActions={false}
  />

  <section class="section section--tight">
    <div class="container container--narrow">
      <div class="prose">
        <Content />
      </div>
      {data.updated && (
        <p class="page-updated mono">
          Ostatnia aktualizacja:{' '}
          {data.updated.toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' })}
        </p>
      )}
    </div>
  </section>

  <ContactBlock />
</Base>

<style>
  .page-updated {
    margin-top: 40px;
    font-size: 10.5px;
    color: var(--muted-2);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
</style>
