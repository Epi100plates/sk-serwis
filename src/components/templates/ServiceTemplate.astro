---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import DiagnosisNote from '../../components/DiagnosisNote.astro';
import Icon from '../../components/Icon.astro';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../lib/schema';
import { withBase } from '../../lib/url';
import { applyPriceTokens, displayPrice } from '../../lib/prices';
import site from '../../data/site.json';

interface Props {
  entry: any;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

// Ceny w frontmatterze to tokeny {{cena:KLUCZ}} albo gotowe kwoty - tu zamieniamy
// je na wartości z cennika (placeholder => "wycena po diagnozie").
const priceFrom = data.priceFrom ? displayPrice(data.priceFrom) : undefined;
const priceNote = data.priceNote ? applyPriceTokens(data.priceNote) : undefined;
const title = applyPriceTokens(data.title);
const description = applyPriceTokens(data.description);
const h1 = applyPriceTokens(data.h1);
const lead = applyPriceTokens(data.lead);
const navLabel = applyPriceTokens(data.navLabel);
const faq = data.faq.map((f: any) => ({ q: applyPriceTokens(f.question), a: applyPriceTokens(f.answer) }));

const all = await getCollection('uslugi', ({ data: d }: any) => (typeof process !== "undefined" && process.env.PREVIEW === "1") || !d.draft);
const related = all.filter((s: any) => data.related.includes(s.id));

const chips = [
  ...(priceFrom ? [{ label: 'Cena', value: priceFrom }] : []),
  ...(data.duration ? [{ label: 'Czas realizacji', value: applyPriceTokens(data.duration) }] : []),
  { label: 'Przyjęcie', value: 'Bez umawiania' },
  { label: 'Diagnostyka', value: '0 zł* przy naprawie' },
];

const schema = [
  serviceSchema({
    name: h1,
    description,
    path: `/${entry.id}/`,
    priceFrom,
  }),
  breadcrumbSchema([
    { label: 'Start', path: '/' },
    { label: 'Usługi', path: '/uslugi/' },
    { label: navLabel, path: `/${entry.id}/` },
  ]),
  ...(faq.length ? [faqSchema(faq)] : []),
];
---

<Base
  title={`${title} | Studio-Komp`}
  description={description}
  canonicalPath={`/${entry.id}/`}
  schema={schema}
>
  <PageHero
    h1={h1}
    lead={lead}
    crumbs={[{ label: 'Usługi', href: '/uslugi/' }, { label: navLabel }]}
    chips={chips}
  />

  <section class="section section--tight service-section">
    <div class="container service-layout">
      <article class="service-body">
        {
          data.problems.length > 0 && (
            <div class="service-problems">
              <p class="mono service-problems__label">Z tym problemem?</p>
              <ul>
                {data.problems.map((p: string) => (
                  <li>
                    <Icon name="check" size={15} strokeWidth={2} />
                    {applyPriceTokens(p)}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="prose">
          <Content />
        </div>
        {
          data.updated && (
            <p class="service-updated mono">
              Ostatnia aktualizacja:{' '}
              {data.updated.toLocaleDateString('pl-PL', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
              })}
            </p>
          )
        }
      </article>

      <aside class="service-aside">
        {
          (priceFrom || priceNote) && (
            <div class="aside-box aside-box--price">
              <p class="mono aside-box__label">Cena</p>
              {priceFrom && <p class="aside-box__price">{priceFrom}</p>}
              {priceNote && <p class="aside-box__note">{priceNote}</p>}
            </div>
          )
        }

        {
          data.includes.length > 0 && (
            <div class="aside-box">
              <p class="mono aside-box__label">Co obejmuje usługa</p>
              <ul class="aside-list">
                {data.includes.map((item: string) => (
                  <li>
                    <Icon name="check" size={14} strokeWidth={2} />
                    {applyPriceTokens(item)}
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="aside-box aside-box--cta">
          <p class="mono aside-box__label">Kontakt</p>
          <a
            class="aside-box__phone"
            href={`tel:${site.phoneTel}`}
            data-track="call"
            data-location={`usluga-${entry.id}`}
          >
            {site.phoneDisplay}
          </a>
          <p class="aside-box__note">
            {site.address.street}, {site.address.city}
            <br />
            pon-pt 7:00-15:00, bez umawiania
          </p>
          <a
            class="btn btn--primary btn--block"
            href={`tel:${site.phoneTel}`}
            data-track="call"
            data-location={`usluga-${entry.id}-cta`}
          >
            <Icon name="phone" size={17} /> Zadzwoń
          </a>
          <a
            class="btn btn--outline btn--block"
            href={site.directionsUrl}
            target="_blank"
            rel="noopener"
            data-track="directions"
            data-location={`usluga-${entry.id}`}
          >
            <Icon name="pin" size={17} /> Wyznacz trasę
          </a>
        </div>

        <DiagnosisNote compact />
      </aside>
    </div>
  </section>

  {faq.length > 0 && <Faq items={faq} title="Częste pytania" intro="Najczęściej pytacie nas o to przy przyjęciu sprzętu." />}

  {
    related.length > 0 && (
      <section class="section section--tight related">
        <div class="container">
          <div class="section-head">
            <h2>Powiązane usługi</h2>
            <div class="section-head__aside">
              <a class="link-arrow" href={withBase('/uslugi/')}>
                Wszystkie usługi <Icon name="arrow" size={16} />
              </a>
            </div>
          </div>
          <ul class="related__list">
            {related.map((s: any) => (
              <li>
                <a class="related__item" href={withBase(`/${s.id}/`)}>
                  <span>
                    <span class="related__title">{applyPriceTokens(s.data.navLabel)}</span>
                    <span class="related__teaser">{applyPriceTokens(s.data.teaser)}</span>
                  </span>
                  <Icon name="arrow" size={18} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <ContactBlock />
</Base>

<style>
  .service-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(280px, 0.8fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .service-problems {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 22px 24px;
    margin-bottom: 36px;
  }

  .service-problems__label {
    color: var(--muted-2);
    margin-bottom: 12px;
  }

  .service-problems ul {
    list-style: none;
    display: grid;
    gap: 8px;
  }

  .service-problems li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    line-height: 1.45;
  }

  .service-problems li svg {
    margin-top: 3px;
    color: var(--ink);
  }

  .service-updated {
    margin-top: 40px;
    font-size: 10.5px;
    color: var(--muted-2);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .service-aside {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .aside-box {
    border: 1px solid var(--line);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--paper);
  }

  .aside-box--price {
    background: var(--yellow);
    border-color: var(--yellow);
  }

  .aside-box__label {
    color: var(--muted-2);
    font-size: 10px;
  }

  .aside-box--price .aside-box__label {
    color: rgba(14, 16, 15, 0.72);
  }

  .aside-box__price {
    font-size: clamp(26px, 2.4vw, 34px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .aside-box__note {
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
  }

  .aside-box--price .aside-box__note {
    color: rgba(14, 16, 15, 0.7);
  }

  .aside-list {
    list-style: none;
    display: grid;
    gap: 9px;
  }

  .aside-list li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    font-size: 13.5px;
    line-height: 1.45;
  }

  .aside-list li svg {
    margin-top: 3px;
    flex: none;
  }

  .aside-box--cta {
    background: var(--graphite);
    border-color: var(--graphite);
    color: var(--on-dark);
    gap: 12px;
  }

  .aside-box--cta .aside-box__label {
    color: var(--on-dark-muted);
  }

  .aside-box__phone {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .aside-box__phone:hover {
    color: var(--yellow);
  }

  .aside-box--cta .aside-box__note {
    color: var(--on-dark-muted);
  }

  .aside-box--cta .btn--outline {
    --btn-fg: var(--on-dark);
    --btn-border: var(--dark-line);
  }

  .related__list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(28px, 4vw, 64px);
    border-top: 1px solid var(--ink);
  }

  .related__item {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }

  .related__item:hover .related__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .related__item > span {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .related__title {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .related__teaser {
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
    max-width: 40ch;
  }

  @media (max-width: 960px) {
    .service-layout {
      grid-template-columns: 1fr;
    }

    .service-aside {
      position: static;
      order: -1;
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .aside-box--cta {
      grid-column: 1 / -1;
    }

    .related__list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .service-aside {
      grid-template-columns: 1fr;
    }
  }
</style>
