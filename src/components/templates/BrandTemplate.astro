---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import DiagnosisNote from '../../components/DiagnosisNote.astro';
import Icon from '../../components/Icon.astro';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../lib/schema';
import { withBase } from '../../lib/url';
import { applyPriceTokens, price } from '../../lib/prices';
import site from '../../data/site.json';

interface Props {
  entry: any;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const title = applyPriceTokens(data.title);
const description = applyPriceTokens(data.description);
const h1 = applyPriceTokens(data.h1);
const lead = applyPriceTokens(data.lead);
const brand = applyPriceTokens(data.brand);

const services = await getCollection('uslugi', ({ data: d }: any) => (typeof process !== "undefined" && process.env.PREVIEW === "1") || !d.draft);
const related = data.services
  .map((slug: string) => services.find((s: any) => s.id === slug))
  .filter(Boolean);
const allBrands = await getCollection('marki', ({ data: d }: any) => (typeof process !== "undefined" && process.env.PREVIEW === "1") || !d.draft);
const otherBrands = allBrands.filter((m: any) => m.id !== entry.id);

const chips = [
  { label: 'Diagnostyka', value: '0 zł* przy naprawie' },
  { label: 'Ekspres', value: `+${price('ekspres')}` },
  { label: 'Przyjęcie', value: 'Bez umawiania' },
];

const faqItems = data.faq.map((f: any) => ({ q: applyPriceTokens(f.question), a: applyPriceTokens(f.answer) }));

const schema = [
  serviceSchema({
    name: h1,
    description,
    path: `/${entry.id}/`,
  }),
  breadcrumbSchema([
    { label: 'Start', path: '/' },
    { label: 'Serwis marek', path: '/uslugi/' },
    { label: brand, path: `/${entry.id}/` },
  ]),
  ...(faqItems.length ? [faqSchema(faqItems)] : []),
  {
    '@context': 'https://schema.org',
    '@type': 'Brand',
    name: brand,
  },
];
---

<Base
  title={`${title} | Studio-Komp`}
  description={description}
  canonicalPath={`/${entry.id}/`}
  schema={schema}
>
  <section class="brand-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Serwis marek', href: '/uslugi/' }, { label: brand }]} />
      <p class="mono brand-hero__kicker">Serwis {brand} Wrocław</p>
      <h1 class="brand-hero__title">{h1}</h1>
      <p class="lead brand-hero__lead">{lead}</p>

      <dl class="brand-hero__chips">
        {chips.map((chip) => (
          <div class="brand-hero__chip">
            <dt class="mono">{chip.label}</dt>
            <dd>{chip.value}</dd>
          </div>
        ))}
      </dl>

      <div class="brand-hero__actions">
        <a class="btn btn--primary btn--lg" href={`tel:${site.phoneTel}`} data-track="call" data-location={`marka-${entry.id}`}>
          <Icon name="phone" size={18} /> {site.phoneDisplay}
        </a>
        <a class="btn btn--outline btn--lg" href={site.directionsUrl} target="_blank" rel="noopener" data-track="directions" data-location={`marka-${entry.id}`}>
          <Icon name="pin" size={18} /> Wyznacz trasę
        </a>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container brand-layout">
      <div class="brand-body">
        {
          data.problems.length > 0 && (
            <div class="brand-problems">
              <p class="mono brand-problems__label">Typowe problemy</p>
              <ul>
                {data.problems.map((p: string) => (
                  <li>
                    <Icon name="check" size={15} strokeWidth={2} /> {applyPriceTokens(p)}
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="prose">
          <Content />
        </div>

        {
          data.repairs.length > 0 && (
            <section class="brand-repairs">
              <h2>Najczęstsze naprawy {brand}</h2>
              <ul class="brand-repairs__list">
                {data.repairs.map((r: string) => (
                  <li>{applyPriceTokens(r)}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          data.models.length > 0 && (
            <section class="brand-models">
              <h2>Modele, które trafiają do nas najczęściej</h2>
              <ul class="brand-models__list">
                {data.models.map((m: string) => (
                  <li class="mono">{m}</li>
                ))}
              </ul>
              <p class="brand-models__note">
                To przykłady serii, nie lista ograniczeń - przyjmujemy również inne modele.
              </p>
            </section>
          )
        }

        <DiagnosisNote />
      </div>

      <aside class="brand-aside">
        <div class="aside-box aside-box--cta">
          <p class="mono aside-box__label">Kontakt</p>
          <a class="aside-box__phone" href={`tel:${site.phoneTel}`} data-track="call" data-location={`marka-${entry.id}-aside`}>
            {site.phoneDisplay}
          </a>
          <p class="aside-box__note">
            {site.address.street}, {site.address.city}
            <br />
            pon-pt 7:00-15:00
          </p>
          <a class="btn btn--primary btn--block" href={`tel:${site.phoneTel}`} data-track="call" data-location={`marka-${entry.id}-aside-cta`}>
            <Icon name="phone" size={17} /> Zadzwoń
          </a>
          <a class="btn btn--outline btn--block" href={site.directionsUrl} target="_blank" rel="noopener" data-track="directions" data-location={`marka-${entry.id}-aside`}>
            <Icon name="pin" size={17} /> Wyznacz trasę
          </a>
        </div>

        {
          related.length > 0 && (
            <div class="aside-box">
              <p class="mono aside-box__label">Usługi dla {brand}</p>
              <ul class="aside-list">
                {related.map((s: any) => (
                  <li>
                    <a href={withBase(`/${s.id}/`)}>{s.data.navLabel}</a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="aside-box">
          <p class="mono aside-box__label">Adres</p>
          <a class="aside-box__address" href={site.mapsUrl} target="_blank" rel="noopener" data-track="directions" data-location={`marka-${entry.id}-address`}>
            {site.address.street}
            <br />
            {site.address.postalCode} {site.address.city}
          </a>
        </div>
      </aside>
    </div>
  </section>

  {faqItems.length > 0 && <Faq items={faqItems} title={`Pytania o serwis ${brand}`} intro="Najczęstsze pytania dotyczące napraw tej marki." />}

  <section class="section section--tight">
    <div class="container">
      <div class="section-head">
        <h2>Serwis innych marek</h2>
        <div class="section-head__aside">
          <a class="link-arrow" href={withBase('/uslugi/')}>
            Wszystkie usługi <Icon name="arrow" size={16} />
          </a>
        </div>
      </div>
      <ul class="brand-links">
        {
          otherBrands.map((m: any) => (
            <li>
              <a class="brand-links__item" href={withBase(`/${m.id}/`)}>
                <span>{m.data.brand}</span>
                <Icon name="arrow" size={15} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ContactBlock />
</Base>

<style>
  .brand-hero {
    padding-block: clamp(24px, 4vw, 44px) clamp(36px, 5vw, 64px);
  }

  .brand-hero__kicker {
    margin-top: 22px;
    color: var(--muted-2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .brand-hero__title {
    margin-top: 12px;
    max-width: 24ch;
    font-size: clamp(34px, 5vw, 72px);
  }

  .brand-hero__lead {
    margin-top: 18px;
    max-width: 56ch;
  }

  .brand-hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 32px 0 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .brand-hero__chip {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 28px 14px 0;
    margin-right: 28px;
    border-right: 1px solid var(--line);
  }

  .brand-hero__chip:last-child {
    border-right: 0;
  }

  .brand-hero__chip dt {
    color: var(--muted-2);
    font-size: 10px;
    letter-spacing: 0.07em;
  }

  .brand-hero__chip dd {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
  }

  .brand-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .brand-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(280px, 0.8fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .brand-problems {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 22px 24px;
    margin-bottom: 36px;
  }

  .brand-problems__label {
    color: var(--muted-2);
    margin-bottom: 12px;
  }

  .brand-problems ul {
    list-style: none;
    display: grid;
    gap: 8px;
  }

  .brand-problems li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    line-height: 1.45;
  }

  .brand-problems li svg {
    margin-top: 3px;
    flex: none;
  }

  .brand-repairs,
  .brand-models {
    margin-top: 36px;
    border-top: 1px solid var(--line);
    padding-top: 26px;
  }

  .brand-repairs h2,
  .brand-models h2 {
    font-size: clamp(24px, 2.4vw, 34px);
    margin-bottom: 16px;
  }

  .brand-repairs__list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 32px;
  }

  .brand-repairs__list li {
    position: relative;
    padding-left: 18px;
    font-size: 15px;
    line-height: 1.45;
  }

  .brand-repairs__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 7px;
    height: 7px;
    background: var(--yellow);
  }

  .brand-models__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .brand-models__list li {
    padding: 7px 12px;
    border: 1px solid var(--line-strong);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .brand-models__note {
    margin-top: 12px;
    font-size: 13px;
    color: var(--muted);
  }

  .brand-aside {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .aside-box {
    border: 1px solid var(--line);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--paper);
  }

  /* W trybie ciemnym tło strony jest prawie czarne - karta dostaje powierzchnię. */
  :global(html[data-theme='dark']) .aside-box:not(.aside-box--cta) {
    background: var(--surface);
  }

  .aside-box--cta {
    background: var(--graphite);
    border-color: var(--graphite);
    color: var(--on-dark);
    gap: 12px;
  }

  .aside-box__label {
    color: var(--muted-2);
    font-size: 10px;
  }

  .aside-box--cta .aside-box__label {
    color: var(--on-dark-muted);
  }

  .aside-box__phone {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .aside-box__phone:hover {
    color: var(--yellow);
  }

  .aside-box__note {
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
  }

  .aside-box--cta .aside-box__note {
    color: var(--on-dark-muted);
  }

  .aside-box--cta .btn--outline {
    --btn-fg: var(--on-dark);
    --btn-border: var(--dark-line);
  }

  .aside-list {
    list-style: none;
    display: grid;
    gap: 8px;
  }

  .aside-list a,
  .aside-box__address {
    font-size: 14px;
    line-height: 1.45;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--line-strong);
  }

  .brand-links {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(20px, 4vw, 56px);
    border-top: 1px solid var(--ink);
  }

  .brand-links__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    font-size: 16px;
    font-weight: 500;
  }

  .brand-links__item:hover span {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--yellow);
  }

  @media (max-width: 960px) {
    .brand-layout {
      grid-template-columns: 1fr;
    }

    .brand-aside {
      position: static;
      order: -1;
    }

    .brand-repairs__list {
      grid-template-columns: 1fr;
    }

    .brand-links {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .brand-hero__chip {
      padding-right: 18px;
      margin-right: 18px;
      flex: 1 1 40%;
    }

    .brand-links {
      grid-template-columns: 1fr;
    }
  }
</style>
