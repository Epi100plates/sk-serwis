---
import Icon from './Icon.astro';
import site from '../data/site.json';

interface Props {
  /** Zachowane dla zgodności z wcześniejszym API - kadruje kartę mapy. */
  crop?: boolean;
}

const { crop = false } = Astro.props;

const mapSrc = site.mapEmbedUrl;
const addressLabel = `${site.address.street}, ${site.address.postalCode} ${site.address.city}`;
const frameTitle = 'Mapa Google - Studio-Komp, Kotlarska 14, Wrocław';
const gridId = `mapgrid-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['map-card', crop && 'map-card--crop']} data-map>
  <div class="map-card__skeleton" aria-hidden="true">
    <svg
      class="map-card__grid"
      viewBox="0 0 600 460"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <pattern id={gridId} width="44" height="44" patternUnits="userSpaceOnUse">
          <path d="M44 0H0V44" fill="none" stroke="#2b302b" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="600" height="460" fill={`url(#${gridId})`} />
      <path d="M0 290h600M0 132h600M196 0v460M430 0v460" stroke="#394038" stroke-width="2" />
      <path d="M0 364L600 232" stroke="#394038" stroke-width="1.5" />
      <path d="M0 84L600 150" stroke="#2f352f" stroke-width="1" />
    </svg>
    <span class="map-card__loading mono">Ładowanie mapy…</span>
  </div>

  <iframe
    class="map-card__iframe"
    data-map-frame
    src={mapSrc}
    title={frameTitle}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>

  <script is:inline>
    (function () {
      var script = document.currentScript;
      var card = script && script.parentElement ? script.parentElement.closest('[data-map]') : null;
      var frame = card ? card.querySelector('[data-map-frame]') : null;
      if (!card || !frame) return;
      frame.addEventListener('load', function () {
        card.classList.add('is-loaded');
        frame.classList.add('is-ready');
      });
    })();
  </script>

  <div class="map-card__pin" aria-hidden="true">
    <span class="map-card__pin-dot"></span>
    <span class="map-card__pin-label mono">Kotlarska 14</span>
  </div>

  <div class="map-card__bar">
    <a
      class="map-card__address"
      href={site.mapsUrl}
      target="_blank"
      rel="noopener"
      data-track="map"
      data-location="mapa"
    >
      <Icon name="pin" size={15} />
      <span>{addressLabel}</span>
    </a>
    <div class="map-card__actions">
      <a
        class="btn btn--primary map-card__btn"
        href={site.directionsUrl}
        target="_blank"
        rel="noopener"
        data-track="directions"
        data-location="mapa"
      >
        Wyznacz trasę
      </a>
      <a
        class="link-arrow map-card__maps"
        href={site.mapsUrl}
        target="_blank"
        rel="noopener"
        data-track="map"
        data-location="mapa"
      >
        Otwórz w Google Maps <Icon name="arrow-up-right" size={15} />
      </a>
    </div>
  </div>

  <noscript>
    <p class="map-card__noscript">
      Mapa wymaga JavaScriptu.{' '}
      <a href={site.mapsUrl} target="_blank" rel="noopener">Otwórz mapę w Google Maps</a>.
    </p>
  </noscript>
</div>

<style>
  .map-card {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 420px;
    background: var(--graphite);
    border: 1px solid var(--dark-line);
    overflow: hidden;
    isolation: isolate;
  }

  /* Siatka techniczna jako tło/skeleton do czasu załadowania mapy. */
  .map-card__skeleton {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 18px;
    pointer-events: none;
    transition: opacity var(--slow) var(--ease-out);
  }

  .map-card.is-loaded .map-card__skeleton {
    opacity: 0;
  }

  .map-card__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.9;
  }

  .map-card__loading {
    position: relative;
    color: var(--on-dark-muted);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .map-card__iframe {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    border: 0;
    opacity: 0;
    transition: opacity var(--slow) var(--ease-out);
  }

  .map-card__iframe.is-ready {
    opacity: 1;
  }

  /* Bez JS: pokaż mapę od razu (jest <noscript> z linkiem zapasowym). */
  @media (scripting: none) {
    .map-card__iframe {
      opacity: 1;
    }
  }

  /* Etykieta z adresem - nie przechwytuje kliknięć w mapę. */
  .map-card__pin {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 11px;
    background: rgba(14, 16, 15, 0.88);
    border: 1px solid var(--dark-line);
    color: var(--on-dark);
    pointer-events: none;
  }

  .map-card__pin-dot {
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 0 0 0 4px rgba(255, 212, 0, 0.18);
  }

  .map-card__pin-label {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--on-dark);
  }

  .map-card__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 4;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    padding: 18px;
    background: linear-gradient(
      180deg,
      rgba(14, 16, 15, 0) 0%,
      rgba(14, 16, 15, 0.82) 42%,
      rgba(14, 16, 15, 0.95) 100%
    );
  }

  .map-card__address {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--on-dark);
    max-width: 100%;
  }

  .map-card__address:hover {
    color: var(--yellow);
  }

  .map-card__address svg {
    flex: none;
  }

  .map-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
  }

  .map-card__btn {
    min-height: 46px;
    padding-inline: 20px;
    font-size: 14px;
  }

  .map-card__maps {
    font-size: 13.5px;
    color: var(--on-dark);
  }

  .map-card__maps:hover {
    color: var(--yellow);
  }

  .map-card__noscript {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    z-index: 5;
    padding: 14px 16px;
    background: var(--graphite);
    border: 1px solid var(--dark-line);
    font-size: 13px;
    color: var(--on-dark-muted);
  }

  .map-card__noscript a {
    color: var(--yellow);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 899px) {
    .map-card {
      min-height: 320px;
    }

    .map-card--crop {
      min-height: 320px;
    }

    .map-card__bar {
      padding: 14px;
    }

    .map-card__actions {
      width: 100%;
      gap: 10px;
    }

    .map-card__btn {
      flex: 1 1 auto;
    }

    .map-card__address {
      font-size: 12.5px;
    }
  }
</style>
