---
import Icon from './Icon.astro';
import { withBase } from '../lib/url';

interface Props {
  crop?: boolean;
}
---

<div class="map-card" data-map>
  <div class="map-card__placeholder" data-map-placeholder>
    <svg class="map-card__grid" viewBox="0 0 600 420" aria-hidden="true" focusable="false" preserveAspectRatio="none">
      <defs>
        <pattern id="mapgrid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M40 0H0V40" fill="none" stroke="#2b302b" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="600" height="420" fill="url(#mapgrid)" />
      <path d="M0 260h600M0 120h600M180 0v420M420 0v420" stroke="#394038" stroke-width="2" />
      <path d="M0 330L600 210" stroke="#394038" stroke-width="1.5" />
    </svg>
    <div class="map-card__pin" aria-hidden="true">
      <span class="map-card__pin-dot"></span>
      <span class="map-card__pin-label mono">Kotlarska 14</span>
    </div>
    <button type="button" class="btn btn--primary" data-map-load>
      <Icon name="pin" size={17} /> Pokaż mapę
    </button>
    <p class="map-card__note">
      Mapę ładujemy dopiero po kliknięciu — żeby strona działała szybciej.
    </p>
  </div>
</div>

<script>
  const wraps = document.querySelectorAll<HTMLElement>('[data-map]');
  const mapSrc =
    'https://www.google.com/maps?q=Kotlarska+14,+50-150+Wroc%C5%82aw&z=16&output=embed';

  wraps.forEach((wrap) => {
    const placeholder = wrap.querySelector<HTMLElement>('[data-map-placeholder]');
    const btn = wrap.querySelector<HTMLButtonElement>('[data-map-load]');
    btn?.addEventListener('click', () => {
      if (!placeholder) return;
      const iframe = document.createElement('iframe');
      iframe.src = mapSrc;
      iframe.title = 'Mapa Google — Studio-Komp, Kotlarska 14, Wrocław';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.setAttribute('allowfullscreen', '');
      iframe.className = 'map-card__iframe';
      wrap.replaceChild(iframe, placeholder);
    });
  });
</script>

<style>
  .map-card {
    position: relative;
    width: 100%;
    min-height: 420px;
    background: #121514;
    border: 1px solid var(--dark-line);
    overflow: hidden;
    height: 100%;
  }

  .map-card__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 24px;
    text-align: center;
  }

  .map-card__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.9;
  }

  .map-card__pin {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    z-index: 1;
  }

  .map-card__pin-dot {
    width: 18px;
    height: 18px;
    background: var(--yellow);
    border: 2px solid var(--ink);
    border-radius: 50%;
    box-shadow: 0 0 0 8px rgba(255, 212, 0, 0.16);
  }

  .map-card__pin-label {
    font-size: 10px;
    color: var(--on-dark);
    letter-spacing: 0.08em;
  }

  .map-card__placeholder .btn {
    position: relative;
    z-index: 1;
  }

  .map-card__note {
    position: relative;
    z-index: 1;
    font-size: 12px;
    color: var(--on-dark-muted);
    max-width: 30ch;
  }

  .map-card__iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
