---
import Icon from './Icon.astro';
import MapCard from './MapCard.astro';
import site from '../data/site.json';

interface Props {
  title?: string;
  text?: string;
  id?: string;
}
const {
  title = 'Przyjdź bez umawiania',
  text = 'Nie musisz rezerwować terminu ani dzwonić z wyprzedzeniem. Przyjedź na Kotlarską 14 w godzinach pracy, zostaw laptopa i wróć po naprawie - najczęściej następnego dnia.',
  id = 'kontakt',
} = Astro.props;
---

<section class="section section--dark contact" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <div class="contact__grid">
      <div class="contact__copy">
        <h2 id={`${id}-title`}>{title}</h2>
        <p class="lead contact__text">{text}</p>

        <div class="contact__phone-block">
          <span class="contact__phone-label mono">Zadzwoń</span>
          <a
            class="contact__phone"
            href={`tel:${site.phoneTel}`}
            data-track="call"
            data-location="kontakt"
          >
            {site.phoneDisplay}
          </a>
        </div>

        <div class="contact__details">
          <div class="contact__detail">
            <span class="contact__detail-label mono">Adres</span>
            <p>
              {site.address.street}<br />
              {site.address.postalCode} {site.address.city}
            </p>
          </div>
          <div class="contact__detail">
            <span class="contact__detail-label mono">Godziny</span>
            <p>
              Poniedziałek-piątek<br />
              7:00-15:00
            </p>
          </div>
        </div>

        <div class="contact__actions">
          <a
            class="btn btn--primary btn--lg"
            href={`tel:${site.phoneTel}`}
            data-track="call"
            data-location="kontakt-cta"
          >
            <Icon name="phone" size={18} /> Zadzwoń teraz
          </a>
          <a
            class="btn btn--outline btn--lg"
            href={site.directionsUrl}
            target="_blank"
            rel="noopener"
            data-track="directions"
            data-location="kontakt"
          >
            <Icon name="pin" size={18} /> Wyznacz trasę
          </a>
        </div>
      </div>

      <MapCard />
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: stretch;
  }

  .contact__text {
    margin-top: 18px;
    max-width: 44ch;
  }

  .contact__phone-block {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--dark-line);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .contact__phone-label {
    color: var(--on-dark-muted);
    font-size: 10.5px;
  }

  .contact__phone {
    font-size: clamp(38px, 4.4vw, 58px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    width: fit-content;
  }

  .contact__phone:hover {
    color: var(--yellow);
  }

  .contact__details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 30px;
    padding-top: 22px;
    border-top: 1px solid var(--dark-line);
  }

  .contact__detail-label {
    display: block;
    color: var(--on-dark-muted);
    font-size: 10.5px;
    margin-bottom: 6px;
  }

  .contact__detail p {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--on-dark);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  @media (max-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }

    .contact__details {
      grid-template-columns: 1fr 1fr;
    }

    .contact__actions .btn {
      flex: 1 1 auto;
    }
  }

  /* Mobile: kontakt ma być krótki i prowadzić do działania. */
  @media (max-width: 899px) {
    .contact.section {
      padding-block: 34px;
    }

    .contact__text {
      display: none;
    }

    .contact__phone-block {
      margin-top: 16px;
      padding-top: 12px;
    }

    .contact__phone {
      font-size: 40px;
    }

    .contact__details {
      display: none;
    }

    .contact__actions {
      margin-top: 18px;
      gap: 8px;
    }

    .contact__actions .btn {
      flex: 1 1 100%;
      min-height: 48px;
    }

    .contact :global(.map-card) {
      min-height: 210px !important;
    }

    .contact :global(.map-card__note) {
      display: none;
    }
  }
</style>
