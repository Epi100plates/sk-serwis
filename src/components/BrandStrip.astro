---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { withBase } from '../lib/url';

// Marki z kolekcji (CMS). Gdy brak podstron — statyczna lista bez linków.
const fallback = [
  'ASUS',
  'Lenovo',
  'Apple',
  'Dell',
  'HP',
  'Acer',
  'MSI',
  'Samsung',
  'Toshiba',
  'Microsoft Surface',
];

let brands: { label: string; href: string | null }[] = [];
try {
  const marki = (await getCollection('marki', ({ data }) => (typeof process !== "undefined" && process.env.PREVIEW === "1") || !data.draft)).sort(
    (a, b) => a.data.order - b.data.order
  );
  brands = marki.map((m) => ({ label: m.data.brand, href: `/${m.id}/` }));
} catch {
  brands = [];
}

if (brands.length === 0) {
  brands = fallback.map((b) => ({ label: b, href: null }));
}
---

<div class="brands">
  <p class="brands__label">
    Naprawiamy wszystkie marki laptopów i komputerów
  </p>
  <ul class="brands__list" aria-label="Obsługiwane marki">
    {
      brands.map((b) => (
        <li>
          {b.href ? (
            <a href={withBase(b.href)} data-track="service" data-location="marki">
              {b.label}
            </a>
          ) : (
            <span>{b.label}</span>
          )}
        </li>
      ))
    }
    <li class="brands__more">i inne</li>
  </ul>
</div>

<style>
  .brands {
    display: flex;
    align-items: baseline;
    gap: 14px 36px;
    flex-wrap: wrap;
    padding-block: 22px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .brands__label {
    font-size: 13px;
    color: var(--muted);
    letter-spacing: -0.005em;
  }

  .brands__list {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 26px;
    list-style: none;
    margin-left: auto;
  }

  .brands__list li {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--muted);
    transition: color var(--fast) var(--ease-out);
  }

  .brands__list a {
    display: inline-block;
    padding-block: 2px;
    border-bottom: 1px solid transparent;
  }

  .brands__list a:hover {
    color: var(--ink);
    border-bottom-color: var(--yellow);
  }

  .brands__more {
    font-weight: 400 !important;
    font-family: var(--font-mono);
    font-size: 11px !important;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .brands {
      display: block;
      padding-block: 16px;
    }

    .brands__label {
      margin-bottom: 10px;
      font-size: 12px;
    }

    .brands__list {
      margin-left: 0;
      gap: 8px 18px;
    }

    .brands__list li {
      font-size: 13.5px;
    }
  }
</style>
