---
import { withBase } from '../lib/url';
---

<div class="cookie-bar" data-cookie-bar hidden role="dialog" aria-label="Zgoda na pliki cookies">
  <div class="cookie-bar__inner">
    <p class="cookie-bar__text">
      Używamy plików cookies do analityki i reklam, żeby lepiej dopasować stronę
      i mierzyć skuteczność działań. Możesz zaakceptować wszystkie albo wybrać
      tylko niezbędne. Szczegóły w
      <a href={withBase('/polityka-prywatnosci/')}>polityce prywatności</a>.
    </p>
    <div class="cookie-bar__actions">
      <button type="button" class="btn btn--primary cookie-bar__btn" data-cookie-accept>
        Akceptuję
      </button>
      <button type="button" class="btn btn--outline cookie-bar__btn" data-cookie-decline>
        Tylko niezbędne
      </button>
    </div>
  </div>
</div>

<script>
  const KEY = 'sk_consent';
  const bar = document.querySelector<HTMLElement>('[data-cookie-bar]');

  function read(): string | null {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  }

  function store(value: 'granted' | 'denied') {
    try {
      localStorage.setItem(KEY, value);
    } catch {
      /* brak dostępu do localStorage — zgoda tylko na tę sesję */
    }
    window.dispatchEvent(new Event('sk-consent-changed'));
    if (bar) bar.hidden = true;
  }

  if (bar && read() === null) {
    window.setTimeout(() => {
      bar.hidden = false;
    }, 1200);
  }

  bar?.querySelector('[data-cookie-accept]')?.addEventListener('click', () => store('granted'));
  bar?.querySelector('[data-cookie-decline]')?.addEventListener('click', () => store('denied'));

  document.querySelectorAll('[data-cookie-settings]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      if (bar) bar.hidden = false;
    });
  });
</script>

<style>
  .cookie-bar {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: 16px;
    z-index: 120;
    display: flex;
    justify-content: flex-start;
    pointer-events: none;
  }

  .cookie-bar[hidden] {
    display: none;
  }

  .cookie-bar__inner {
    pointer-events: auto;
    width: min(620px, 100%);
    background: var(--paper);
    border: 1px solid var(--ink);
    padding: 18px 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
    box-shadow: 0 18px 40px -28px rgba(14, 16, 15, 0.5);
  }

  .cookie-bar__text {
    flex: 1 1 280px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
  }

  .cookie-bar__text a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cookie-bar__actions {
    display: flex;
    gap: 8px;
    flex: 1 1 auto;
    justify-content: flex-end;
  }

  .cookie-bar__btn {
    min-height: 40px;
    padding-inline: 16px;
    font-size: 13px;
    white-space: nowrap;
  }

  @media (max-width: 899px) {
    .cookie-bar {
      bottom: calc(74px + env(safe-area-inset-bottom, 0px));
      left: 10px;
      right: 10px;
    }

    .cookie-bar__inner {
      padding: 16px;
      gap: 12px;
    }

    .cookie-bar__actions {
      width: 100%;
      justify-content: stretch;
    }

    .cookie-bar__btn {
      flex: 1;
    }
  }
</style>
