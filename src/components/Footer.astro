---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import site from '../data/site.json';

const uslugi = (await getCollection('uslugi', ({ data }) => (typeof process !== "undefined" && process.env.PREVIEW === "1") || !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const footerServices = uslugi.slice(0, 8);
const year = new Date().getFullYear();

const marki = (await getCollection('marki', ({ data }) => (typeof process !== "undefined" && process.env.PREVIEW === "1") || !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo size={44} />
        <p class="site-footer__desc">{site.footer.description}</p>
        <a
          class="site-footer__phone"
          href={`tel:${site.phoneTel}`}
          data-track="call"
          data-location="footer"
        >
          {site.phoneDisplay}
        </a>
        <a
          class="btn btn--primary site-footer__cta"
          href={`tel:${site.phoneTel}`}
          data-track="call"
          data-location="footer-cta"
        >
          <Icon name="phone" size={17} /> Zadzwoń teraz
        </a>
      </div>

      <nav class="site-footer__col" aria-label="Usługi">
        <p class="mono site-footer__label">Usługi</p>
        <ul>
          {footerServices.map((s) => (
            <li><a href={withBase(`/${s.id}/`)}>{s.data.navLabel}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label="Informacje">
        <p class="mono site-footer__label">Informacje</p>
        <ul>
          {site.footer.infoLinks.map((l) => (
            <li><a href={withBase(l.href)}>{l.label}</a></li>
          ))}
        </ul>
        {marki.length > 0 && (
          <>
            <p class="mono site-footer__label site-footer__label--second">Marki</p>
            <ul>
              {marki.slice(0, 6).map((m) => (
                <li><a href={withBase(`/${m.id}/`)}>{m.data.brand}</a></li>
              ))}
            </ul>
          </>
        )}
      </nav>

      <div class="site-footer__col site-footer__col--contact">
        <p class="mono site-footer__label">Serwis</p>
        <address>
          <a href={site.mapsUrl} target="_blank" rel="noopener" data-track="directions" data-location="footer-address">
            <span>{site.address.street}</span>
            <span>{site.address.postalCode} {site.address.city}</span>
          </a>
        </address>
        <p class="site-footer__hours">{site.hours[0].label}: {site.hours[0].value}</p>
        <p class="site-footer__hours">Sobota i niedziela: nieczynne</p>
        <a
          class="link-arrow site-footer__dir"
          href={site.directionsUrl}
          target="_blank"
          rel="noopener"
          data-track="directions"
          data-location="footer"
        >
          Wyznacz trasę <Icon name="arrow-up-right" size={15} />
        </a>
        <a
          class="link-arrow site-footer__dir"
          href={site.social.facebook}
          target="_blank"
          rel="noopener"
        >
          Facebook <Icon name="arrow-up-right" size={15} />
        </a>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} Studio-Komp. Serwis laptopów we Wrocławiu.</p>
      <nav class="site-footer__legal" aria-label="Dokumenty">
        {site.footer.legalLinks.map((l) => (
          <a href={withBase(l.href)}>{l.label}</a>
        ))}
        <button type="button" data-cookie-settings>Ustawienia cookies</button>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--graphite);
    color: var(--on-dark);
    padding-block: clamp(52px, 6vw, 84px) 28px;
    font-size: 15px;
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.1fr;
    gap: clamp(28px, 4vw, 64px);
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    max-width: 34ch;
  }

  .site-footer__desc {
    color: var(--on-dark-muted);
    font-size: 14px;
    line-height: 1.55;
  }

  .site-footer__phone {
    font-size: clamp(24px, 2.4vw, 30px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .site-footer__phone:hover {
    color: var(--yellow);
  }

  .site-footer__cta {
    margin-top: 4px;
  }

  .site-footer__label {
    color: var(--on-dark-muted);
    margin-bottom: 16px;
  }

  .site-footer__label--second {
    margin-top: 24px;
  }

  .site-footer__col ul {
    list-style: none;
    display: grid;
    gap: 9px;
  }

  .site-footer__col a {
    color: #d7dad5;
    font-size: 14.5px;
    line-height: 1.35;
  }

  .site-footer__col a:hover {
    color: var(--yellow);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .site-footer__col address {
    font-style: normal;
    color: #d7dad5;
    font-size: 14.5px;
    line-height: 1.5;
    display: grid;
    margin-bottom: 12px;
  }

  .site-footer__hours {
    color: var(--on-dark-muted);
    font-size: 13.5px;
    line-height: 1.5;
  }

  .site-footer__dir {
    margin-top: 10px;
    font-size: 14px;
    color: var(--on-dark);
    width: fit-content;
  }

  .site-footer__dir:hover {
    color: var(--yellow);
  }

  .site-footer__bottom {
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: 20px;
    border-top: 1px solid var(--dark-line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    color: var(--on-dark-muted);
    font-size: 13px;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .site-footer__legal a,
  .site-footer__legal button {
    color: var(--on-dark-muted);
    font-size: 13px;
    padding: 0;
  }

  .site-footer__legal a:hover,
  .site-footer__legal button:hover {
    color: var(--on-dark);
  }

  @media (max-width: 900px) {
    .site-footer__top {
      grid-template-columns: 1fr 1fr;
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  /* Mobile: krótka stopka — najważniejsze linki i kontakt. */
  @media (max-width: 899px) {
    .site-footer {
      padding-block: 34px 16px;
    }

    .site-footer__top {
      gap: 20px 18px;
    }

    .site-footer__brand {
      gap: 10px;
      max-width: none;
    }

    .site-footer__desc {
      font-size: 12.5px;
      line-height: 1.5;
    }

    .site-footer__phone {
      font-size: 24px;
    }

    .site-footer__cta {
      display: none;
    }

    .site-footer__col:first-of-type {
      display: none;
    }

    .site-footer__label {
      margin-bottom: 10px;
      font-size: 10px;
    }

    .site-footer__label--second,
    .site-footer__label--second + ul {
      display: none;
    }

    .site-footer__col ul {
      gap: 7px;
    }

    .site-footer__col a {
      font-size: 13px;
    }

    .site-footer__hours {
      font-size: 12px;
    }

    .site-footer__bottom {
      margin-top: 24px;
      padding-top: 14px;
      font-size: 11.5px;
    }

    .site-footer__legal {
      gap: 14px;
    }
  }

  @media (max-width: 560px) {
    .site-footer__top {
      grid-template-columns: 1fr;
    }
  }
</style>
