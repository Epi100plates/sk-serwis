---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import site from '../data/site.json';

const uslugi = (await getCollection('uslugi', ({ data }) => (typeof process !== "undefined" && process.env.PREVIEW === "1") || !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const footerServices = uslugi.slice(0, 8);
const year = new Date().getFullYear();

const marki = (await getCollection('marki', ({ data }) => (typeof process !== "undefined" && process.env.PREVIEW === "1") || !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo size={44} />
        <p class="site-footer__desc">{site.footer.description}</p>
        <a
          class="site-footer__phone"
          href={`tel:${site.phoneTel}`}
          data-track="call"
          data-location="footer"
        >
          {site.phoneDisplay}
        </a>
        <a
          class="btn btn--primary site-footer__cta"
          href={`tel:${site.phoneTel}`}
          data-track="call"
          data-location="footer-cta"
        >
          <Icon name="phone" size={17} /> Zadzwoń teraz
        </a>
      </div>

      <nav class="site-footer__col" aria-label="Usługi">
        <div class="site-footer__group" data-accordion>
          <button
            type="button"
            class="site-footer__toggle"
            data-accordion-toggle
            aria-expanded="false"
            aria-controls="footer-uslugi"
          >
            <span class="site-footer__toggle-label">Usługi</span>
            <span class="site-footer__chev" aria-hidden="true"><Icon name="chevron-down" size={16} /></span>
          </button>
          <p class="mono site-footer__label">Usługi</p>
          <div class="site-footer__panel" id="footer-uslugi" data-accordion-panel>
            <ul>
              {footerServices.map((s) => (
                <li><a href={withBase(`/${s.id}/`)}>{s.data.navLabel}</a></li>
              ))}
            </ul>
          </div>
        </div>
      </nav>

      <nav class="site-footer__col site-footer__col--info" aria-label="Informacje i marki">
        <div class="site-footer__group" data-accordion>
          <button
            type="button"
            class="site-footer__toggle"
            data-accordion-toggle
            aria-expanded="false"
            aria-controls="footer-informacje"
          >
            <span class="site-footer__toggle-label">Informacje</span>
            <span class="site-footer__chev" aria-hidden="true"><Icon name="chevron-down" size={16} /></span>
          </button>
          <p class="mono site-footer__label">Informacje</p>
          <div class="site-footer__panel" id="footer-informacje" data-accordion-panel>
            <ul>
              {site.footer.infoLinks.map((l) => (
                <li><a href={withBase(l.href)}>{l.label}</a></li>
              ))}
            </ul>
          </div>
        </div>

        {marki.length > 0 && (
          <div class="site-footer__group" data-accordion>
            <button
              type="button"
              class="site-footer__toggle"
              data-accordion-toggle
              aria-expanded="false"
              aria-controls="footer-marki"
            >
              <span class="site-footer__toggle-label">Marki</span>
              <span class="site-footer__chev" aria-hidden="true"><Icon name="chevron-down" size={16} /></span>
            </button>
            <p class="mono site-footer__label site-footer__label--second">Marki</p>
            <div class="site-footer__panel" id="footer-marki" data-accordion-panel>
              <ul class="site-footer__marki">
                {marki.map((m) => (
                  <li><a href={withBase(`/${m.id}/`)}>{m.data.brand}</a></li>
                ))}
              </ul>
            </div>
          </div>
        )}
      </nav>

      <div class="site-footer__col site-footer__col--contact">
        <p class="mono site-footer__label">Serwis</p>
        <address>
          <a href={site.mapsUrl} target="_blank" rel="noopener" data-track="directions" data-location="footer-address">
            <span>{site.address.street}</span>
            <span>{site.address.postalCode} {site.address.city}</span>
          </a>
        </address>
        <p class="site-footer__hours">{site.hours[0].label}: {site.hours[0].value}</p>
        <p class="site-footer__hours">Sobota i niedziela: nieczynne</p>
        <a
          class="link-arrow site-footer__dir"
          href={site.directionsUrl}
          target="_blank"
          rel="noopener"
          data-track="directions"
          data-location="footer"
        >
          Wyznacz trasę <Icon name="arrow-up-right" size={15} />
        </a>
        <a
          class="link-arrow site-footer__dir"
          href={site.social.facebook}
          target="_blank"
          rel="noopener"
        >
          Facebook <Icon name="arrow-up-right" size={15} />
        </a>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} Studio-Komp. Serwis laptopów we Wrocławiu.</p>
      <nav class="site-footer__legal" aria-label="Dokumenty">
        {site.footer.legalLinks.map((l) => (
          <a href={withBase(l.href)}>{l.label}</a>
        ))}
        <button type="button" data-cookie-settings>Ustawienia cookies</button>
      </nav>
    </div>
  </div>
  <script is:inline>
    (function () {
      var s = document.currentScript;
      var f = s && s.closest ? s.closest('.site-footer') : null;
      if (!f) return;
      f.classList.add('is-accordion-ready');
      f.querySelectorAll('[data-accordion]').forEach(function (group) {
        var toggle = group.querySelector('[data-accordion-toggle]');
        var panel = group.querySelector('[data-accordion-panel]');
        if (!toggle || !panel) return;
        group.classList.add('is-accordion');
        toggle.addEventListener('click', function () {
          var expanded = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', String(!expanded));
          group.classList.toggle('is-open', !expanded);
        });
      });
    })();
  </script>
</footer>

<style>
  .site-footer {
    background: var(--graphite);
    color: var(--on-dark);
    padding-block: clamp(52px, 6vw, 84px) 28px;
    font-size: 15px;
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.1fr;
    gap: clamp(28px, 4vw, 64px);
  }

  .site-footer__top > * {
    min-width: 0;
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    max-width: 34ch;
  }

  .site-footer__desc {
    color: var(--on-dark-muted);
    font-size: 14px;
    line-height: 1.55;
  }

  .site-footer__phone {
    font-size: clamp(24px, 2.4vw, 30px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .site-footer__phone:hover {
    color: var(--yellow);
  }

  .site-footer__cta {
    margin-top: 4px;
  }

  .site-footer__label {
    color: var(--on-dark-muted);
    margin-bottom: 16px;
  }

  .site-footer__label--second {
    margin-top: 24px;
  }

  /* Akordeon mobile - przyciski istnieją w DOM, ale są widoczne tylko z JS. */
  .site-footer__toggle {
    display: none;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    border-top: 1px solid var(--dark-line);
    color: var(--on-dark);
    text-align: left;
  }

  .site-footer__toggle-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }

  .site-footer__chev {
    display: inline-flex;
    color: var(--on-dark-muted);
    transition: transform var(--fast) var(--ease-out);
  }

  .site-footer__toggle[aria-expanded='true'] .site-footer__chev {
    transform: rotate(180deg);
    color: var(--yellow);
  }

  .site-footer__col ul {
    list-style: none;
    display: grid;
    gap: 9px;
    min-width: 0;
  }

  .site-footer__col a {
    color: #d7dad5;
    font-size: 14.5px;
    line-height: 1.35;
    overflow-wrap: break-word;
  }

  .site-footer__col a:hover {
    color: var(--yellow);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Marki: 9 pozycji w zwartych dwóch kolumnach w obrębie kolumny Informacje. */
  .site-footer__col .site-footer__marki {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px 14px;
    align-items: start;
  }

  .site-footer__marki li {
    min-width: 0;
  }

  .site-footer__marki a {
    font-size: 13.5px;
    line-height: 1.35;
  }

  .site-footer__col address {
    font-style: normal;
    color: #d7dad5;
    font-size: 14.5px;
    line-height: 1.5;
    display: grid;
    margin-bottom: 12px;
  }

  .site-footer__hours {
    color: var(--on-dark-muted);
    font-size: 13.5px;
    line-height: 1.5;
  }

  .site-footer__dir {
    margin-top: 10px;
    font-size: 14px;
    color: var(--on-dark);
    width: fit-content;
  }

  .site-footer__dir:hover {
    color: var(--yellow);
  }

  .site-footer__bottom {
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: 20px;
    border-top: 1px solid var(--dark-line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    color: var(--on-dark-muted);
    font-size: 13px;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .site-footer__legal a,
  .site-footer__legal button {
    color: var(--on-dark-muted);
    font-size: 13px;
    padding: 0;
  }

  .site-footer__legal a:hover,
  .site-footer__legal button:hover {
    color: var(--on-dark);
  }

  /* Mobile (<=899px): sekcje jako akordeon, kontakt zawsze widoczny. */
  @media (max-width: 899px) {
    .site-footer {
      padding-block: 34px 16px;
    }

    .site-footer__top {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .site-footer__brand {
      gap: 10px;
      max-width: none;
      padding-bottom: 18px;
    }

    .site-footer__desc {
      font-size: 12.5px;
      line-height: 1.5;
    }

    .site-footer__phone {
      font-size: 24px;
    }

    .site-footer__cta {
      display: none;
    }

    /* Etykiety desktopowe zastępuje akordeon dopiero, gdy JS go aktywuje. */
    .site-footer.is-accordion-ready .site-footer__group .site-footer__label {
      display: none;
    }

    .site-footer__toggle {
      display: none;
    }

    .site-footer.is-accordion-ready .site-footer__toggle {
      display: flex;
    }

    .site-footer__group.is-accordion .site-footer__panel {
      display: none;
      padding-bottom: 14px;
    }

    .site-footer__group.is-accordion.is-open .site-footer__panel {
      display: block;
    }

    .site-footer__col ul {
      gap: 7px;
    }

    .site-footer__col a {
      font-size: 13px;
    }

    .site-footer__col .site-footer__marki {
      gap: 6px 16px;
    }

    .site-footer__marki a {
      font-size: 13px;
    }

    .site-footer__col--contact {
      padding-top: 14px;
      border-top: 1px solid var(--dark-line);
    }

    .site-footer__col--contact .site-footer__label {
      margin-bottom: 10px;
      font-size: 10px;
    }

    .site-footer__hours {
      font-size: 12px;
    }

    .site-footer__bottom {
      margin-top: 24px;
      padding-top: 14px;
      font-size: 11.5px;
    }

    .site-footer__legal {
      gap: 14px;
    }
  }
</style>
