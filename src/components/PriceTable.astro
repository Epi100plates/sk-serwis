---
interface PriceItem {
  name: string;
  price: string;
  note?: string;
}
interface PriceGroup {
  title: string;
  items: PriceItem[];
}
interface Props {
  groups: PriceGroup[];
  compactNames?: string[];
  showNotes?: boolean;
}
const { groups, compactNames, showNotes = true } = Astro.props;

const flat = groups.flatMap((g) => g.items);
const compactItems = compactNames
  ? compactNames
      .map((name) => flat.find((i) => i.name === name))
      .filter((i): i is PriceItem => Boolean(i))
  : null;
---

{
  compactItems ? (
    <ul class="price price--compact">
      {compactItems.map((item) => (
        <li class="price__item">
          <span class="price__name">{item.name}</span>
          <span class="price__value mono">{item.price}</span>
        </li>
      ))}
    </ul>
  ) : (
    <div class="price-groups">
      {groups.map((group) => (
        <section class="price-group">
          <h3 class="price-group__title">{group.title}</h3>
          <ul class="price">
            {group.items.map((item) => (
              <li class="price__item">
                <span class="price__main">
                  <span class="price__name">{item.name}</span>
                  {showNotes && item.note && <span class="price__note">{item.note}</span>}
                </span>
                <span class="price__value mono">{item.price}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )
}

<style>
  .price-groups {
    display: grid;
    gap: clamp(36px, 5vw, 56px);
  }

  .price-group__title {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--ink);
    margin-bottom: 4px;
  }

  .price {
    list-style: none;
    display: grid;
  }

  .price__item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }

  .price__main {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .price__name {
    font-size: clamp(16px, 1.3vw, 18px);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .price__note {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--muted);
    max-width: 56ch;
  }

  .price__value {
    font-size: clamp(15px, 1.3vw, 17px);
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--ink);
  }

  .price--compact .price__item {
    padding: 16px 0;
  }

  .price--compact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(28px, 4vw, 64px);
    border-top: 1px solid var(--ink);
  }

  .price--compact .price__item {
    border-bottom: 1px solid var(--line);
  }

  .price--compact .price__item:nth-child(-n + 2) {
    border-top: 0;
  }

  @media (max-width: 760px) {
    .price--compact {
      grid-template-columns: 1fr;
    }

    .price__item {
      padding: 15px 0;
      gap: 16px;
    }

    .price__value {
      font-size: 15px;
    }
  }
</style>
