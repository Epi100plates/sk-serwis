---
import site from '../data/site.json';

interface Props {
  size?: number; // wysokość logo w px
  variant?: 'dark' | 'light'; // zachowane dla kompatybilności (logo jest na grafitowym tle)
  showWordmark?: boolean;
  class?: string;
  label?: string;
}
const {
  size = 46,
  class: klass = '',
  label = 'Studio-Komp — serwis laptopów we Wrocławiu',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/` || '/';
const logo = site.branding.logoTransparent || site.branding.logo;
const ratio = site.branding.logoWidth / site.branding.logoHeight;
const width = Math.round(size * ratio);
---

<a class:list={['logo', klass]} href={href} aria-label={label}>
  <img
    class="logo__img"
    src={`${base}${logo}`}
    alt="Studio-Komp — serwis laptopów"
    width={width}
    height={size}
    style={`height:${size}px;width:${width}px`}
    loading="eager"
    decoding="async"
  />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    flex: none;
    line-height: 0;
  }

  .logo__img {
    display: block;
    object-fit: contain;
    object-position: left center;
  }

  @media (max-width: 899px) {
    .logo__img {
      height: 34px !important;
      width: auto !important;
      max-width: 120px;
    }
  }
</style>
