---
import { withBase } from '../lib/url';

interface Item {
  label: string;
  href?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Ścieżka nawigacji">
  <ol>
    <li><a href={withBase('/')}>Start</a></li>
    {
      items.map((item, i) => (
        <li>
          {item.href && i < items.length - 1 ? (
            <a href={withBase(item.href)}>{item.label}</a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
    font-size: 12.5px;
    color: var(--muted);
    letter-spacing: -0.005em;
  }

  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
  }

  .breadcrumbs li + li::before {
    content: '/';
    margin-inline: 8px;
    color: var(--line-strong);
  }

  .breadcrumbs a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .breadcrumbs [aria-current='page'] {
    color: var(--ink);
  }

  :global(.section--dark) .breadcrumbs ol {
    color: var(--on-dark-muted);
  }

  :global(.section--dark) .breadcrumbs [aria-current='page'] {
    color: var(--on-dark);
  }
</style>
