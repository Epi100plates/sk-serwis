---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import CaseGrid from '../../components/CaseGrid.astro';
import Icon from '../../components/Icon.astro';
import DiagnosisNote from '../../components/DiagnosisNote.astro';
import realizacje from '../../data/realizacje.json';
import site from '../../data/site.json';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';
import { withBase } from '../../lib/url';

export const getStaticPaths = (async () => {
  return realizacje.items
    .filter((i) => (typeof process !== "undefined" && process.env.PREVIEW === "1") || !i.draft)
    .map((item) => ({ params: { slug: item.slug }, props: { item } }));
}) satisfies GetStaticPaths;

const { item } = Astro.props;
const categories = [...realizacje.categories].sort((a, b) => a.order - b.order);
const category = categories.find((c) => c.slug === item.category);
const labelBySlug = Object.fromEntries(categories.map((c) => [c.slug, c.label]));
const others = realizacje.items
  .filter((i) => (typeof process !== "undefined" && process.env.PREVIEW === "1") || !i.draft && i.slug !== item.slug)
  .slice(0, 3);

const device = item.device || [item.brand, item.model].filter(Boolean).join(' ');
const gallery = (item.gallery ?? []).filter((g) => g.src);
const seoTitle = item.seo?.title || `${item.title} — realizacja serwisu | Studio-Komp`;
const seoDescription =
  item.seo?.description ||
  `${item.title} — ${device}. ${item.summary} Serwis laptopów Studio-Komp, Kotlarska 14, Wrocław.`;

const services = await getCollection('uslugi', ({ data }) => (typeof process !== "undefined" && process.env.PREVIEW === "1") || !data.draft);
const relatedServices = services.slice(0, 3);

const schema = [
  breadcrumbSchema([
    { label: 'Start', path: '/' },
    { label: 'Realizacje', path: '/realizacje/' },
    { label: item.title, path: `/realizacje/${item.slug}/` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: item.title,
    description: seoDescription,
    articleSection: category?.label ?? 'Realizacje',
    inLanguage: 'pl-PL',
  },
];
---

<Base
  title={seoTitle}
  description={seoDescription}
  canonicalPath={`/realizacje/${item.slug}/`}
  type="article"
  schema={schema}
>
  <article class="case-detail">
    <header class="case-detail__head">
      <div class="container container--narrow">
        <Breadcrumbs items={[{ label: 'Realizacje', href: '/realizacje/' }, { label: item.title }]} />
        <p class="case-detail__meta mono">
          {category?.label && <span>{category.label}</span>}
          {device && <><span aria-hidden="true">·</span><span>{device}</span></>}
          {(item.time || item.hours) && (
            <><span aria-hidden="true">·</span><span>{item.time || item.hours}</span></>
          )}
        </p>
        <h1 class="case-detail__title">{item.title}</h1>
        <p class="lead case-detail__lead">{item.summary}</p>
      </div>
    </header>

    <div class="container container--narrow">
      {item.beforeAfter && (
        <BeforeAfter
          before={withBase(item.beforeAfter.before)}
          after={withBase(item.beforeAfter.after)}
        />
      )}

      {!item.beforeAfter && item.image && (
        <figure class="case-detail__figure">
          <img src={withBase(item.image)} alt={item.title} width="1200" height="800" loading="eager" decoding="async" />
        </figure>
      )}

      <div class="case-detail__grid">
        <div class="case-detail__body">
          {item.problem && (
            <section class="case-block">
              <h2>Problem</h2>
              <p>{item.problem}</p>
            </section>
          )}
          {item.diagnosis && (
            <section class="case-block">
              <h2>Diagnoza</h2>
              <p>{item.diagnosis}</p>
            </section>
          )}
          {item.repair && (
            <section class="case-block">
              <h2>Przebieg naprawy</h2>
              <p>{item.repair}</p>
            </section>
          )}
          {item.result && (
            <section class="case-block case-block--result">
              <h2>Wynik</h2>
              <p>{item.result}</p>
            </section>
          )}

          {gallery.length > 0 && (
            <section class="case-block">
              <h2>Zdjęcia z naprawy</h2>
              <ul class="case-gallery" data-gallery>
                {gallery.map((g, i) => (
                  <li>
                    <button type="button" class="case-gallery__btn" data-gallery-open data-src={withBase(g.src)} aria-label={`Powiększ zdjęcie ${i + 1}`}>
                      <img src={withBase(g.src)} alt={g.alt ?? item.title} width="600" height="450" loading="lazy" decoding="async" />
                    </button>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <DiagnosisNote compact />
        </div>

        <aside class="case-detail__aside">
          <div class="aside-box aside-box--cta">
            <p class="mono aside-box__label">Masz podobny problem?</p>
            <a class="aside-box__phone" href={`tel:${site.phoneTel}`} data-track="call" data-location="realizacja">
              {site.phoneDisplay}
            </a>
            <p class="aside-box__note">
              {site.address.street}, {site.address.city}
              <br />
              pon–pt 7:00–15:00, bez umawiania
            </p>
            <a class="btn btn--primary btn--block" href={`tel:${site.phoneTel}`} data-track="call" data-location="realizacja-cta">
              <Icon name="phone" size={17} /> Zadzwoń
            </a>
            <a class="btn btn--outline btn--block" href={site.directionsUrl} target="_blank" rel="noopener" data-track="directions" data-location="realizacja">
              <Icon name="pin" size={17} /> Wyznacz trasę
            </a>
          </div>

          <div class="aside-box">
            <p class="mono aside-box__label">Powiązane usługi</p>
            <ul class="aside-list">
              {relatedServices.map((s) => (
                <li><a href={withBase(`/${s.id}/`)}>{s.data.navLabel}</a></li>
              ))}
            </ul>
            <a class="link-arrow" href={withBase('/uslugi/')}>
              Wszystkie usługi <Icon name="arrow" size={15} />
            </a>
          </div>
        </aside>
      </div>
    </div>
  </article>

  <section class="section section--tight">
    <div class="container">
      <div class="section-head">
        <h2>Inne realizacje</h2>
        <div class="section-head__aside">
          <a class="link-arrow" href={withBase('/realizacje/')}>
            Wszystkie realizacje <Icon name="arrow" size={16} />
          </a>
        </div>
      </div>
      <CaseGrid items={others} categoryLabels={labelBySlug} />
    </div>
  </section>

  <ContactBlock />
</Base>

<div class="lightbox" data-lightbox hidden>
  <button type="button" class="lightbox__close" data-lightbox-close aria-label="Zamknij podgląd">×</button>
  <img class="lightbox__img" data-lightbox-img alt="" />
</div>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const box = document.querySelector<HTMLElement>('[data-lightbox]');
  const boxImg = document.querySelector<HTMLImageElement>('[data-lightbox-img]');
  gallery?.querySelectorAll<HTMLButtonElement>('[data-gallery-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!box || !boxImg) return;
      boxImg.src = btn.dataset.src || '';
      box.hidden = false;
      window.dispatchEvent(new CustomEvent('sk:event', { detail: { name: 'gallery_open', params: {} } }));
    });
  });
  const close = () => {
    if (box) box.hidden = true;
  };
  box?.addEventListener('click', (e) => {
    if (e.target === box) close();
  });
  document.querySelector('[data-lightbox-close]')?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });
</script>

<style>
  .case-detail__head {
    padding-block: clamp(24px, 4vw, 40px) clamp(28px, 4vw, 48px);
  }

  .case-detail__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 22px;
    color: var(--muted-2);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .case-detail__title {
    margin-top: 16px;
    max-width: 24ch;
    font-size: clamp(32px, 4.6vw, 64px);
  }

  .case-detail__lead {
    margin-top: 18px;
  }

  .case-detail__figure {
    margin: 0 0 40px;
    border: 1px solid var(--line);
    background: var(--graphite);
  }

  .case-detail__figure img {
    width: 100%;
    height: auto;
  }

  .case-detail__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(280px, 0.8fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
    padding-bottom: clamp(40px, 6vw, 72px);
  }

  .case-block {
    border-top: 1px solid var(--line);
    padding-block: 24px;
  }

  .case-block h2 {
    font-size: clamp(22px, 2vw, 28px);
    margin-bottom: 12px;
  }

  .case-block p {
    font-size: 16px;
    line-height: 1.65;
    color: #2a2e2b;
    max-width: 68ch;
  }

  .case-block--result {
    background: var(--surface);
    border: 1px solid var(--line);
    padding-inline: 20px;
  }

  .case-detail__aside {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .aside-box {
    border: 1px solid var(--line);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--paper);
  }

  .aside-box--cta {
    background: var(--graphite);
    border-color: var(--graphite);
    color: var(--on-dark);
  }

  .aside-box__label {
    color: var(--muted-2);
    font-size: 10px;
  }

  .aside-box--cta .aside-box__label {
    color: var(--on-dark-muted);
  }

  .aside-box__phone {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .aside-box__phone:hover {
    color: var(--yellow);
  }

  .aside-box__note {
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
  }

  .aside-box--cta .aside-box__note {
    color: var(--on-dark-muted);
  }

  .aside-box--cta .btn--outline {
    --btn-fg: var(--on-dark);
    --btn-border: var(--dark-line);
  }

  .aside-list {
    list-style: none;
    display: grid;
    gap: 8px;
  }

  .aside-list a {
    font-size: 14px;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--line-strong);
  }

  .aside-list a:hover {
    text-decoration-color: var(--ink);
  }

  .case-gallery {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 16px;
  }

  .case-gallery__btn {
    display: block;
    width: 100%;
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .case-gallery__btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background: rgba(20, 24, 28, 0.92);
    padding: 24px;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox__img {
    max-width: min(1200px, 100%);
    max-height: 90vh;
    object-fit: contain;
  }

  .lightbox__close {
    position: absolute;
    top: 18px;
    right: 22px;
    font-size: 34px;
    line-height: 1;
    color: #fff;
  }

  @media (max-width: 900px) {
    .case-detail__grid {
      grid-template-columns: 1fr;
    }

    .case-detail__aside {
      position: static;
      order: -1;
    }

    .case-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
