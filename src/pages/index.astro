---
import Base from '../layouts/Base.astro';
import ServiceDocket from '../components/ServiceDocket.astro';
import BrandStrip from '../components/BrandStrip.astro';
import Reviews from '../components/Reviews.astro';
import ExpressBand from '../components/ExpressBand.astro';
import ServicesShowcase from '../components/ServicesShowcase.astro';
import WhyGrid from '../components/WhyGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import PriceTable from '../components/PriceTable.astro';
import CaseGrid from '../components/CaseGrid.astro';
import Faq from '../components/Faq.astro';
import ContactBlock from '../components/ContactBlock.astro';
import DiagnosisNote from '../components/DiagnosisNote.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
import cennik from '../data/cennik.json';
import faq from '../data/faq.json';
import realizacje from '../data/realizacje.json';
import { faqSchema } from '../lib/schema';
import { withBase, SITE_ORIGIN } from '../lib/url';

const home = site.home;
const hero = home.hero;

const featuredPrices = [
  'Czyszczenie i konserwacja laptopa',
  'Wymiana gniazda zasilania',
  'Naprawa laptopa po zalaniu',
  'Naprawa płyty głównej po zwarciu',
  'Instalacja systemu Windows / macOS / Linux',
  'Odzyskiwanie danych',
];

const mobilePrices = [
  'Czyszczenie i konserwacja laptopa',
  'Wymiana gniazda zasilania',
  'Naprawa laptopa po zalaniu',
];

const categories = [...realizacje.categories].sort((a, b) => a.order - b.order);
const categoryLabels = Object.fromEntries(categories.map((c) => [c.slug, c.label]));

const schema = [
  faqSchema(faq.items),
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE_ORIGIN}/#webpage`,
    url: `${SITE_ORIGIN}/`,
    name: 'Serwis laptopów Wrocław — Studio-Komp',
    description:
      'Serwis laptopów we Wrocławiu. Naprawy z dnia na dzień, bezpłatna diagnoza przy naprawie, ponad 550 opinii Google.',
    inLanguage: 'pl-PL',
    isPartOf: { '@id': `${SITE_ORIGIN}/#website` },
    about: { '@id': `${SITE_ORIGIN}/#serwis` },
  },
];
---

<Base
  title="Serwis laptopów Wrocław — naprawa laptopów i komputerów | Studio-Komp"
  description="Serwis laptopów we Wrocławiu, Kotlarska 14. Naprawy z dnia na dzień, darmowa diagnoza przy naprawie i ponad 550 opinii Google. Bez umawiania — zadzwoń: 500 613 500."
  canonicalPath="/"
  schema={schema}
>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <h1 class="hero__title">
          {hero.titleLines.map((line: string) => <span>{line} </span>)}
        </h1>

        <p class="lead hero__lead">{hero.lead}</p>

        <div class="hero__actions">
          <a
            class="btn btn--primary btn--lg"
            href={`tel:${site.phoneTel}`}
            data-track="call"
            data-location="hero"
          >
            <Icon name="phone" size={18} />
            {hero.ctaPrimary}
          </a>
          <a
            class="btn btn--outline btn--lg"
            href={withBase('/uslugi/')}
            data-track="cta"
            data-location="hero"
          >
            {hero.ctaSecondary}
            <Icon name="arrow" size={17} class="icon-arrow" />
          </a>
        </div>

        <a
          class="hero__where"
          href={site.directionsUrl}
          target="_blank"
          rel="noopener"
          data-track="directions"
          data-location="hero"
        >
          <Icon name="pin" size={15} />
          <span>{site.address.street}, {site.address.city}</span>
          <span class="hero__where-sep">·</span>
          <span>pon.–pt. 7:00–15:00</span>
          <Icon name="arrow-up-right" size={13} />
        </a>

        <dl class="hero__facts">
          {
            home.stats.map((fact) => (
              <div class="hero__fact">
                <dt>{fact.value}</dt>
                <dd>{fact.label}</dd>
              </div>
            ))
          }
        </dl>

        <div class="hero__note desktop-only">
          <DiagnosisNote variant="inline" compact />
        </div>
      </div>

      <div class="hero__object desktop-only">
        <div class="hero__board" aria-hidden="true"></div>
        <ServiceDocket />
      </div>
    </div>
  </section>

  <div class="container">
    <BrandStrip />
  </div>

  <Reviews />
  <div class="desktop-only"><ExpressBand /></div>
  <ServicesShowcase />
  <div class="desktop-only">
    <WhyGrid />
    <ProcessSteps />
  </div>

  <section class="section section--surface pricing-teaser" aria-labelledby="pricing-title">
    <div class="container">
      <div class="pricing-teaser__grid">
        <div class="pricing-teaser__main">
          <div class="section-head pricing-teaser__head">
            <h2 id="pricing-title">Wiesz, ile zapłacisz, zanim zaczniemy</h2>
          </div>
          <div class="desktop-only">
            <PriceTable groups={cennik.groups} compactNames={featuredPrices} showNotes={false} />
          </div>
          <div class="mobile-only">
            <PriceTable groups={cennik.groups} compactNames={mobilePrices} showNotes={false} />
            <div class="pricing-teaser__mobile-note">
              <DiagnosisNote compact />
            </div>
          </div>
          <div class="pricing-teaser__more">
            <a class="btn btn--outline" href={withBase('/cennik/')}>
              Pełny cennik <Icon name="arrow" size={16} class="icon-arrow" />
            </a>
          </div>
        </div>

        <aside class="pricing-teaser__note desktop-only">
          <p class="mono pricing-teaser__note-label">Zasada, którą warto znać</p>
          <h3>{site.diagnosis.title}</h3>
          <p>{site.diagnosis.text}</p>
          <p class="pricing-teaser__express">
            <Icon name="bolt" size={16} />
            Naprawa ekspresowa: <strong>+{site.express.surcharge} zł</strong> — tego samego dnia.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section cases-home desktop-only" aria-labelledby="cases-title">
    <div class="container">
      <div class="section-head">
        <h2 id="cases-title">Realizacje z warsztatu</h2>
        <div class="section-head__aside">
          <p>
            Zalania, płyty główne, matryce, gniazda zasilania. Każda naprawa to
            inny problem i inne rozwiązanie.
          </p>
          <a class="link-arrow" href={withBase('/realizacje/')}>
            Wszystkie realizacje <Icon name="arrow" size={16} />
          </a>
        </div>
      </div>
      <CaseGrid items={realizacje.items.filter((i) => (typeof process !== "undefined" && process.env.PREVIEW === "1") || !i.draft)} limit={5} categoryLabels={categoryLabels} />
    </div>
  </section>

  <Faq
    items={faq.items}
    title="Częste pytania"
    intro="Najczęstsze pytania, które słyszymy przy przyjęciu sprzętu."
    mobileLimit={3}
  />

  <ContactBlock />
</Base>

<style>
  .hero {
    padding-block: clamp(24px, 3.6vw, 52px) clamp(40px, 5vw, 72px);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(340px, 0.88fr);
    gap: clamp(40px, 5vw, 72px);
    align-items: center;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    font-size: clamp(40px, 6.2vw, 88px);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .hero__lead {
    margin-top: clamp(18px, 2.4vw, 26px);
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: clamp(22px, 2.8vw, 32px);
  }

  .hero__where {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 16px;
    font-size: 13px;
    color: var(--muted);
    transition: color var(--fast) var(--ease-out);
  }

  .hero__where:hover {
    color: var(--ink);
  }

  .hero__where-sep {
    color: var(--line-strong);
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: clamp(28px, 3.6vw, 44px) 0 0;
    padding-left: clamp(0px, 2vw, 28px);
    border-top: 1px solid var(--ink);
  }

  .hero__fact {
    padding: 16px 18px 0 0;
    border-right: 1px solid var(--line);
  }

  .hero__fact:last-child {
    border-right: 0;
  }

  .hero__fact dt {
    font-size: clamp(24px, 2.4vw, 32px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .hero__fact dd {
    margin: 8px 0 0;
    font-size: 11.5px;
    line-height: 1.35;
    letter-spacing: 0.01em;
    color: var(--muted);
    max-width: 15ch;
  }

  .hero__note {
    margin-top: 14px;
    max-width: 62ch;
  }

  .hero__object {
    position: relative;
    padding: 8px 0 14px 10px;
    animation: rise 800ms var(--ease-out) both;
  }

  .hero__board {
    position: absolute;
    inset: 22px 22px 0 0;
    background-color: var(--graphite);
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .hero__board::after {
    content: '';
    position: absolute;
    right: 18px;
    top: 18px;
    width: 10px;
    height: 10px;
    background: var(--yellow);
  }

  .pricing-teaser__grid {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .pricing-teaser__head {
    margin-bottom: 34px;
  }

  .pricing-teaser__head h2 {
    max-width: 20ch;
  }

  .pricing-teaser__more {
    margin-top: 28px;
  }

  .pricing-teaser__mobile-note {
    margin-top: 18px;
  }

  .pricing-teaser__note {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    background: var(--graphite);
    color: var(--on-dark);
    padding: clamp(24px, 2.6vw, 34px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .pricing-teaser__note h3 {
    font-size: clamp(21px, 2vw, 26px);
    letter-spacing: -0.03em;
    line-height: 1.15;
    max-width: 22ch;
  }

  .pricing-teaser__note-label {
    color: var(--on-dark-muted);
    font-size: 10.5px;
  }

  .pricing-teaser__note p:not(.pricing-teaser__note-label) {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--on-dark-muted);
  }

  .pricing-teaser__express {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    padding-top: 16px;
    border-top: 1px solid var(--dark-line);
    width: 100%;
    color: var(--on-dark) !important;
  }

  .pricing-teaser__express strong {
    color: var(--yellow);
  }

  @media (max-width: 1000px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .pricing-teaser__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 899px) {
    .hero {
      padding-block: 18px 28px;
    }

    .hero__title {
      font-size: clamp(38px, 11vw, 52px);
    }

    .hero__lead {
      font-size: 16px;
      margin-top: 14px;
    }

    .hero__where {
      margin-top: 12px;
      flex-wrap: wrap;
    }

    .hero__facts {
      margin-top: 22px;
      padding-left: 0;
      grid-template-columns: 1fr 1fr;
    }

    .hero__fact {
      padding: 12px 12px 12px 0;
    }

    .hero__fact:nth-child(2n) {
      border-right: 0;
      padding-left: 12px;
    }

    .hero__fact:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }

    .hero__actions {
      margin-top: 20px;
    }

    .hero__actions .btn {
      flex: 1 1 100%;
    }

    .hero__note {
      margin-top: 12px;
    }
  }
</style>
