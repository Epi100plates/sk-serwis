---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Icon from '../../components/Icon.astro';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';
import { withBase } from '../../lib/url';
import site from '../../data/site.json';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => (typeof process !== "undefined" && process.env.PREVIEW === "1") || !data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

const words = entry.body ? entry.body.trim().split(/\s+/).length : 0;
const minutes = Math.max(3, Math.round(words / 200));

const fmt = (d: Date) =>
  d.toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });

const services = await getCollection('uslugi', ({ data: d }) => (typeof process !== "undefined" && process.env.PREVIEW === "1") || !d.draft);
const service = services.find((s) => s.id === data.service);

const posts = (await getCollection('blog', ({ data: d }) => (typeof process !== "undefined" && process.env.PREVIEW === "1") || !d.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const relatedPosts = posts
  .filter((p) => p.id !== entry.id)
  .sort((a, b) => {
    const aSame = a.data.category === data.category ? 1 : 0;
    const bSame = b.data.category === data.category ? 1 : 0;
    return bSame - aSame;
  })
  .slice(0, 3);

const schema = [
  articleSchema({
    title: data.title,
    description: data.description,
    path: `/poradnik/${entry.id}/`,
    published: data.pubDate.toISOString(),
    modified: (data.updatedDate ?? data.pubDate).toISOString(),
  }),
  breadcrumbSchema([
    { label: 'Start', path: '/' },
    { label: 'Poradnik', path: '/poradnik/' },
    { label: data.title, path: `/poradnik/${entry.id}/` },
  ]),
  ...(data.faq.length ? [faqSchema(data.faq)] : []),
];
---

<Base
  title={`${data.title} | Studio-Komp`}
  description={data.description}
  canonicalPath={`/poradnik/${entry.id}/`}
  type="article"
  schema={schema}
  publishedTime={data.pubDate.toISOString()}
  modifiedTime={(data.updatedDate ?? data.pubDate).toISOString()}
>
  <article class="post">
    <header class="post__header">
      <div class="container container--narrow">
        <Breadcrumbs items={[{ label: 'Poradnik', href: '/poradnik/' }, { label: data.title }]} />
        <p class="post__meta mono">
          <span>{data.category}</span>
          <span aria-hidden="true">·</span>
          <time datetime={data.pubDate.toISOString()}>{fmt(data.pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{minutes} min czytania</span>
        </p>
        <h1 class="post__title">{data.title}</h1>
        <p class="lead post__lead">{data.description}</p>
      </div>
    </header>

    <div class="container container--narrow">
      <div class="prose post__body">
        <Content />
      </div>

      <aside class="post__cta">
        <div class="post__cta-copy">
          <p class="mono post__cta-label">Masz podobny problem?</p>
          <p class="post__cta-title">
            Zamiast zgadywać — sprawdźmy, co się dzieje z Twoim laptopem.
          </p>
          <p class="post__cta-text">
            Diagnoza jest bezpłatna, jeśli zdecydujesz się na naprawę. Możesz
            przyjść bez umawiania albo zadzwonić.
          </p>
        </div>
        <div class="post__cta-actions">
          <a
            class="btn btn--primary"
            href={`tel:${site.phoneTel}`}
            data-track="call"
            data-location="artykul"
          >
            <Icon name="phone" size={17} /> {site.phoneDisplay}
          </a>
          {
            service && (
              <a class="btn btn--outline" href={withBase(`/${service.id}/`)}>
                {service.data.navLabel} <Icon name="arrow" size={16} />
              </a>
            )
          }
        </div>
      </aside>

      <p class="post__author">
        <span class="mono">Opublikowano</span> {fmt(data.pubDate)}
        {data.updatedDate && (
          <>
            <span aria-hidden="true"> · </span>
            <span class="mono">Aktualizacja</span> {fmt(data.updatedDate)}
          </>
        )}
        <span aria-hidden="true"> · </span> Studio-Komp, serwis laptopów we Wrocławiu
      </p>
    </div>
  </article>

  {data.faq.length > 0 && <Faq items={data.faq.map((f) => ({ q: f.question, a: f.answer }))} title="Częste pytania" intro="Dopytujemy o to najczęściej po przeczytaniu tego artykułu." />}

  {
    relatedPosts.length > 0 && (
      <section class="section section--tight">
        <div class="container container--narrow">
          <div class="section-head">
            <h2>Czytaj dalej</h2>
          </div>
          <ul class="next-posts">
            {relatedPosts.map((post) => (
              <li>
                <a class="next-post" href={withBase(`/poradnik/${post.id}/`)}>
                  <span class="next-post__meta mono">{post.data.category}</span>
                  <span class="next-post__title">{post.data.title}</span>
                  <Icon name="arrow" size={18} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <ContactBlock />
</Base>

<style>
  .post__header {
    padding-block: clamp(24px, 3vw, 40px) clamp(28px, 4vw, 48px);
    border-bottom: 1px solid var(--line);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin-top: 26px;
    color: var(--muted);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .post__title {
    margin-top: 16px;
    font-size: clamp(32px, 4.6vw, 58px);
    letter-spacing: -0.04em;
    line-height: 1.02;
    max-width: 26ch;
  }

  .post__lead {
    margin-top: 20px;
    max-width: 62ch;
  }

  .post__body {
    padding-block: clamp(32px, 4vw, 52px);
    max-width: 68ch;
  }

  .post__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 40px;
    padding: clamp(24px, 3vw, 34px);
    background: var(--surface);
    border: 1px solid var(--line);
    margin-bottom: 28px;
  }

  .post__cta-copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 46ch;
  }

  .post__cta-label {
    color: var(--muted-2);
    font-size: 10px;
  }

  .post__cta-title {
    font-size: clamp(20px, 1.9vw, 24px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .post__cta-text {
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
  }

  .post__cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .post__author {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 6px;
    padding-bottom: clamp(32px, 4vw, 48px);
    font-size: 12px;
    color: var(--muted-2);
    border-bottom: 1px solid var(--line);
  }

  .post__author .mono {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .next-posts {
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .next-post {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }

  .next-post__meta {
    flex: none;
    color: var(--muted-2);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .next-post__title {
    flex: 1;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .next-post svg {
    transition: transform var(--fast) var(--ease-out);
  }

  .next-post:hover svg {
    transform: translateX(4px);
  }

  .next-post:hover .next-post__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  @media (max-width: 600px) {
    .next-post {
      flex-wrap: wrap;
      gap: 6px;
    }

    .next-post__title {
      flex: 1 1 100%;
      order: 3;
      font-size: 17px;
    }

    .post__cta {
      align-items: flex-start;
    }
  }
</style>
