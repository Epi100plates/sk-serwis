---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Icon from '../../components/Icon.astro';
import site from '../../data/site.json';
import reviews from '../../data/opinie.json';
import { breadcrumbSchema } from '../../lib/schema';

const rating = site.reviews.rating.toLocaleString('pl-PL', {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
});
const stars = [1, 2, 3, 4, 5];

const schema = [
  breadcrumbSchema([
    { label: 'Start', path: '/' },
    { label: 'Opinie', path: '/opinie/' },
  ]),
];
---

<Base
  title="Opinie klientów - serwis laptopów Wrocław | Studio-Komp"
  description="Ponad 550 opinii Google o serwisie laptopów Studio-Komp we Wrocławiu. Sprawdź oceny i przeczytaj opinie klientów - wszystkie pochodzą z wizytówki Google."
  canonicalPath="/opinie/"
  schema={schema}
>
  <PageHero
    h1="Opinie klientów Studio-Komp"
    lead="Ponad 550 opinii w Google, zbieranych od 2013 roku. Nie przenosimy ich na własną stronę i nie moderujemy - możesz przeczytać je w całości w naszej wizytówce."
    crumbs={[{ label: 'Opinie' }]}
    showActions={false}
  />

  <section class="section section--tight">
    <div class="container">
      <div class="reviews-head">
        <div class="reviews-head__score">
          <p class="reviews-head__value">{rating}<span>/5</span></p>
          <div class="reviews-head__stars" role="img" aria-label={`Ocena ${rating} na 5`}>
            {stars.map(() => <Icon name="star" size={20} />)}
          </div>
          <p class="reviews-head__count">
            Ponad <strong>{site.reviews.countLabel}</strong> opinii Google
          </p>
        </div>

        <div class="reviews-head__actions">
          <a
            class="btn btn--primary"
            href={site.reviews.url}
            target="_blank"
            rel="noopener"
            data-track="review"
            data-location="opinie-wszystkie"
          >
            <Icon name="google" size={17} /> Wszystkie opinie w Google
          </a>
          <a
            class="btn btn--outline"
            href={site.reviews.writeUrl}
            target="_blank"
            rel="noopener"
            data-track="review"
            data-location="opinie-napisz"
          >
            Dodaj swoją opinię
          </a>
        </div>
      </div>

      <ul class="review-grid">
        {
          reviews.items.map((r) => (
            <li class="review-card">
              <a class="review-card__link" href={site.reviews.url} target="_blank" rel="noopener" data-track="review" data-location="opinie-lista">
              <div class="review-card__top">
                <span class="review-card__stars" aria-hidden="true">
                  {stars.map(() => (
                    <Icon name="star" size={14} />
                  ))}
                </span>
                <span class="review-card__source mono">
                  <Icon name="google" size={13} /> Google
                </span>
              </div>
              <blockquote class="review-card__text">{r.text}</blockquote>
              {r.highlight && <p class="review-card__highlight">{r.highlight}</p>}
              <p class="review-card__author">{r.name}</p>
                          </a>
            </li>
          ))
        }
      </ul>

      <div class="reviews-note">
        <p>
          Opinie publikujemy w formie skróconej - pełne treści, wraz z datami
          i ocenami, znajdziesz w
          <a href={site.reviews.url} target="_blank" rel="noopener">wizytówce Google Studio-Komp</a>.
          Nowe opinie dodajemy ręcznie, dlatego na stronie mogą pojawiać się
          z opóźnieniem.
        </p>
      </div>
    </div>
  </section>

  <ContactBlock />
</Base>

<style>
  .reviews-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--ink);
  }

  .reviews-head__score {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .reviews-head__value {
    font-size: clamp(64px, 7vw, 96px);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.9;
  }

  .reviews-head__value span {
    font-size: 0.3em;
    color: var(--muted-2);
    letter-spacing: -0.02em;
    margin-left: 6px;
  }

  .reviews-head__stars {
    display: flex;
    gap: 3px;
  }

  .reviews-head__count {
    font-size: 14px;
    color: var(--muted);
  }

  .reviews-head__count strong {
    color: var(--ink);
  }

  .reviews-head__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .review-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-top: 40px;
  }

  .review-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(22px, 2.4vw, 30px);
    background: var(--paper);
  }

  .review-card__link {
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: inherit;
    height: 100%;
  }

  .review-card__link:hover .review-card__text {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--yellow);
  }


  .review-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .review-card__stars {
    display: flex;
    gap: 2px;
  }

  .review-card__source {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 9.5px;
    color: var(--muted-2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .review-card__text {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: #2a2e2b;
  }

  .review-card__highlight {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink);
    background: var(--yellow-soft);
    padding: 10px 12px;
  }

  .review-card__author {
    margin-top: auto;
    padding-top: 8px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-2);
  }

  .reviews-note {
    margin-top: 28px;
    max-width: 66ch;
    font-size: 13px;
    line-height: 1.55;
    color: var(--muted);
  }

  .reviews-note a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .review-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .reviews-head__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
