---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import ServiceTemplate from '../components/templates/ServiceTemplate.astro';
import BrandTemplate from '../components/templates/BrandTemplate.astro';
import PageTemplate from '../components/templates/PageTemplate.astro';

// Ten sam poziom URL obsługuje: podstrony usług (istniejące SEO), podstrony
// marek (/serwis-asus-wroclaw/) oraz dowolne podstrony utworzone w panelu.
export const getStaticPaths = (async () => {
  const services = await getCollection('uslugi', ({ data }) => Boolean((import.meta.env as any).INCLUDE_DRAFTS) || !data.draft);
  const brands = await getCollection('marki', ({ data }) => Boolean((import.meta.env as any).INCLUDE_DRAFTS) || !data.draft);

  let pages: any[] = [];
  try {
    pages = await getCollection('strony', ({ data }) => Boolean((import.meta.env as any).INCLUDE_DRAFTS) || !data.draft);
  } catch {
    pages = [];
  }

  const serviceSlugs = new Set(services.map((s) => s.id));
  const taken = new Set(serviceSlugs);

  const paths = [
    ...services.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'usluga', entry } })),
  ];

  for (const entry of brands) {
    if (taken.has(entry.id)) continue;
    taken.add(entry.id);
    paths.push({ params: { slug: entry.id }, props: { kind: 'marka', entry } } as any);
  }

  for (const entry of pages) {
    if (taken.has(entry.id)) continue;
    taken.add(entry.id);
    paths.push({ params: { slug: entry.id }, props: { kind: 'strona', entry } } as any);
  }

  return paths;
}) satisfies GetStaticPaths;

const { kind, entry } = Astro.props;
---

{
  kind === 'marka' ? (
    <BrandTemplate entry={entry} />
  ) : kind === 'strona' ? (
    <PageTemplate entry={entry} />
  ) : (
    <ServiceTemplate entry={entry} />
  )
}
