---
import '../styles/global.css';
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/ibm-plex-mono/500.css';
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Logo export</title>
    <style>
      body {
        margin: 0;
        padding: 40px;
        background: #ffffff;
        font-family: var(--font-sans);
        display: grid;
        gap: 40px;
      }

      .row {
        display: flex;
        gap: 40px;
        align-items: center;
        width: fit-content;
        padding: 32px 40px;
      }

      .row--dark {
        background: #0e100f;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 18px;
      }

      .logo__name {
        font-size: 52px;
        font-weight: 600;
        letter-spacing: -0.035em;
        line-height: 1;
        color: #0e100f;
      }

      .logo__tag {
        font-family: var(--font-mono);
        font-size: 13px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #5f645e;
        margin-top: 10px;
      }

      .logo--light .logo__name {
        color: #f5f6f3;
      }

      .logo--light .logo__tag {
        color: #a7aca5;
      }

      .mark {
        flex: none;
      }
    </style>
  </head>
  <body>
    <div class="row" id="logo-dark">
      <div class="logo">
        <svg class="mark" width="104" height="104" viewBox="0 0 36 36" aria-hidden="true">
          <rect width="36" height="36" fill="#0e100f"></rect>
          <path d="M25.5 10.5H13.5V17.5H23V26H11.5" fill="none" stroke="#ffffff" stroke-width="4.2"></path>
          <rect x="24.5" y="24.5" width="6" height="6" fill="#ffd400"></rect>
        </svg>
        <div>
          <div class="logo__name">studio-komp</div>
          <div class="logo__tag">serwis laptopów · wrocław</div>
        </div>
      </div>
    </div>

    <div class="row row--dark" id="logo-light">
      <div class="logo logo--light">
        <svg class="mark" width="104" height="104" viewBox="0 0 36 36" aria-hidden="true">
          <rect width="36" height="36" fill="#f5f6f3"></rect>
          <path d="M25.5 10.5H13.5V17.5H23V26H11.5" fill="none" stroke="#0e100f" stroke-width="4.2"></path>
          <rect x="24.5" y="24.5" width="6" height="6" fill="#ffd400"></rect>
        </svg>
        <div>
          <div class="logo__name">studio-komp</div>
          <div class="logo__tag">serwis laptopów · wrocław</div>
        </div>
      </div>
    </div>

    <div class="row" id="mark-dark">
      <svg class="mark" width="240" height="240" viewBox="0 0 36 36" aria-hidden="true">
        <rect width="36" height="36" fill="#0e100f"></rect>
        <path d="M25.5 10.5H13.5V17.5H23V26H11.5" fill="none" stroke="#ffffff" stroke-width="4.2"></path>
        <rect x="24.5" y="24.5" width="6" height="6" fill="#ffd400"></rect>
      </svg>
    </div>
  </body>
</html>
