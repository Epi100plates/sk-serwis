{
  "name": "studio-komp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "art": "node scripts/generate-art.mjs",
    "brand": "node scripts/brand.mjs && node scripts/logo-png.mjs",
    "icons": "node scripts/favicon.mjs",
    "og": "node scripts/og.mjs",
    "shots": "node scripts/shot.mjs",
    "qa": "node scripts/qa.mjs",
    "qa:live": "node scripts/check-live.mjs",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/deploy.ps1",
    "pull": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/deploy.ps1 -Pull",
    "provision": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/provision.ps1",
    "publish:remote": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/publish.ps1",
    "publish:now": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/publish.ps1 -Force",
    "publish:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/publish.ps1 -Preview",
    "publisher:install": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/install-publisher-task.ps1",
    "measure": "node scripts/measure.mjs",
    "audit": "node scripts/audit.mjs",
    "interactions": "node scripts/interactions.mjs",
    "theme:qa": "node scripts/theme-qa.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "axe-core": "^4.14.1",
    "lightningcss": "^1.33.0",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5"
  }
}
