# Studio-Komp — baza konfiguracji Apache/LiteSpeed (hosting klasyczny).
# Panel CMS generuje z tego plik public/.htaccess, wstawiając przekierowania
# w miejsce   RewriteRule ^aktualnosci$ https://sk.mati-it.pl/poradnik/ [R=301,L]
  RewriteRule ^aktualnosci$ https://sk.mati-it.pl/poradnik/ [R=301,L]
  RewriteRule ^aktualnoscidlaczego-warto-nas-wybrac.html$ https://sk.mati-it.pl/o-serwisie/ [R=301,L]
  RewriteRule ^aktualnosciindex.html$ https://sk.mati-it.pl/poradnik/ [R=301,L]
  RewriteRule ^aktualnoscistrona-w-przebudowie.html$ https://sk.mati-it.pl/poradnik/ [R=301,L]
  RewriteRule ^cennik.html$ https://sk.mati-it.pl/cennik/ [R=301,L]
  RewriteRule ^galeria.html$ https://sk.mati-it.pl/realizacje/ [R=301,L]
  RewriteRule ^googleads$ https://sk.mati-it.pl/lp/naprawa-laptopow/ [R=301,L]
  RewriteRule ^googleads$ https://sk.mati-it.pl/lp/naprawa-laptopow/ [R=301,L]
  RewriteRule ^kontakt.html$ https://sk.mati-it.pl/kontakt/ [R=301,L]
  RewriteRule ^mapa$ https://sk.mati-it.pl/kontakt/ [R=301,L]
  RewriteRule ^mapa$ https://sk.mati-it.pl/kontakt/ [R=301,L]
  RewriteRule ^o-firmie.html$ https://sk.mati-it.pl/o-serwisie/ [R=301,L]
  RewriteRule ^oferta$ https://sk.mati-it.pl/uslugi/ [R=301,L]
  RewriteRule ^ofertaczyszczenie-i-konserwacja-ukladu-chlodzenia.html$ https://sk.mati-it.pl/czyszczenie-laptopa-wroclaw/ [R=301,L]
. Ten plik leży poza public/, żeby nie trafił na hosting.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Wymuszenie HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Kanoniczny adres bez www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  RewriteBase /

  # --- Przekierowania 301 ze starej strony (zarządzane z panelu) ---
  RewriteRule ^aktualnosci$ https://sk.mati-it.pl/poradnik/ [R=301,L]
  RewriteRule ^aktualnosci$ https://sk.mati-it.pl/poradnik/ [R=301,L]
  RewriteRule ^aktualnoscidlaczego-warto-nas-wybrac.html$ https://sk.mati-it.pl/o-serwisie/ [R=301,L]
  RewriteRule ^aktualnosciindex.html$ https://sk.mati-it.pl/poradnik/ [R=301,L]
  RewriteRule ^aktualnoscistrona-w-przebudowie.html$ https://sk.mati-it.pl/poradnik/ [R=301,L]
  RewriteRule ^cennik.html$ https://sk.mati-it.pl/cennik/ [R=301,L]
  RewriteRule ^galeria.html$ https://sk.mati-it.pl/realizacje/ [R=301,L]
  RewriteRule ^googleads$ https://sk.mati-it.pl/lp/naprawa-laptopow/ [R=301,L]
  RewriteRule ^googleads$ https://sk.mati-it.pl/lp/naprawa-laptopow/ [R=301,L]
  RewriteRule ^kontakt.html$ https://sk.mati-it.pl/kontakt/ [R=301,L]
  RewriteRule ^mapa$ https://sk.mati-it.pl/kontakt/ [R=301,L]
  RewriteRule ^mapa$ https://sk.mati-it.pl/kontakt/ [R=301,L]
  RewriteRule ^o-firmie.html$ https://sk.mati-it.pl/o-serwisie/ [R=301,L]
  RewriteRule ^oferta$ https://sk.mati-it.pl/uslugi/ [R=301,L]
  RewriteRule ^ofertaczyszczenie-i-konserwacja-ukladu-chlodzenia.html$ https://sk.mati-it.pl/czyszczenie-laptopa-wroclaw/ [R=301,L]


  # Katalogi bez ukośnika na końcu → z ukośnikiem
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

# --- Kompresja ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# --- Cache ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/avif "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

AddDefaultCharset UTF-8
