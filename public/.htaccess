# Studio-Komp — konfiguracja Apache/LiteSpeed (obecny hosting)
# Plik trafia do katalogu public/ i jest kopiowany do dist/ przy buildzie.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Wymuszenie HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Kanoniczny adres bez www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  RewriteBase /

  # --- Przekierowania 301 ze starej strony ---
  RewriteRule ^o-firmie\.html$ /o-serwisie/ [R=301,L]
  RewriteRule ^oferta/?$ /uslugi/ [R=301,L]
  RewriteRule ^oferta/czyszczenie-i-konserwacja-ukladu-chlodzenia\.html$ /czyszczenie-laptopa-wroclaw/ [R=301,L]
  RewriteRule ^cennik\.html$ /cennik/ [R=301,L]
  RewriteRule ^galeria\.html$ /realizacje/ [R=301,L]
  RewriteRule ^kontakt\.html$ /kontakt/ [R=301,L]
  RewriteRule ^aktualnosci/?$ /poradnik/ [R=301,L]
  RewriteRule ^aktualnosci/index\.html$ /poradnik/ [R=301,L]
  RewriteRule ^aktualnosci/dlaczego-warto-nas-wybrac\.html$ /o-serwisie/ [R=301,L]
  RewriteRule ^aktualnosci/zalany-laptop.*$ /poradnik/zalany-laptop-czego-nie-robic/ [R=301,L]
  RewriteRule ^aktualnosci/.*laptop-sie-grzeje.*$ /poradnik/laptop-sie-przegrzewa-przyczyny/ [R=301,L]
  RewriteRule ^aktualnosci/strona-w-przebudowie\.html$ /poradnik/ [R=301,L]
  RewriteRule ^googleads/?$ /lp/naprawa-laptopow/ [R=301,L]
  RewriteRule ^mapa/?$ /kontakt/ [R=301,L]

  # Katalogi bez ukośnika na końcu → z ukośnikiem
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

# --- Kompresja ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# --- Cache ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/avif "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Hashed assety Astro mogą być cache'owane agresywnie
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

AddDefaultCharset UTF-8
